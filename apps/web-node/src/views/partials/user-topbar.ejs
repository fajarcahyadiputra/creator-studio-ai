<%
  const topbarPath = typeof path === 'string' ? path : '';
  const topbarAppName = typeof appName === 'string' && appName.trim().length > 0 ? appName : 'Creator AI SaaS';
%>
<header class="workspace-topbar">
  <div class="workspace-topbar__inner">
    <a class="workspace-brand" href="/app/dashboard">
      <span class="workspace-brand__mark"><%- include('./brand-mark', { markClass: 'brand-mark-svg' }) %></span>
      <span class="workspace-brand__text"><%= topbarAppName %></span>
    </a>

    <nav class="workspace-nav">
      <a class="workspace-nav__link <%= topbarPath === '/app/dashboard' ? 'active' : '' %>" href="/app/dashboard">Dashboard</a>
      <details class="workspace-nav__dropdown <%= topbarPath.includes('/app/tools') ? 'workspace-nav__dropdown--active' : '' %>">
        <summary class="workspace-nav__link">Tools AI</summary>
        <div class="workspace-nav__menu">
          <a class="workspace-nav__menu-link <%= topbarPath.startsWith('/app/tools/auto-clipping') ? 'active' : '' %>" href="/app/tools/auto-clipping">Auto Clipping</a>
          <a class="workspace-nav__menu-link <%= topbarPath.startsWith('/app/tools/text-to-speech') ? 'active' : '' %>" href="/app/tools/text-to-speech">Narration TTS</a>
        </div>
      </details>
      <a class="workspace-nav__link <%= topbarPath.startsWith('/app/jobs') ? 'active' : '' %>" href="/app/jobs">Hasil Clipping</a>
      <a class="workspace-nav__link <%= topbarPath.startsWith('/app/media') ? 'active' : '' %>" href="/app/media">Media</a>
      <a class="workspace-nav__link <%= topbarPath.startsWith('/app/presets') ? 'active' : '' %>" href="/app/presets">Templates</a>
      <a class="workspace-nav__link <%= topbarPath.startsWith('/app/settings') ? 'active' : '' %>" href="/app/settings">Settings</a>
      <% if (identity?.permissions?.has('admin.dashboard.view')) { %>
        <a class="workspace-nav__link workspace-nav__link--admin <%= topbarPath.startsWith('/admin') ? 'active' : '' %>" href="/admin/dashboard">Admin</a>
      <% } %>
    </nav>

    <div class="workspace-account">
      <div class="workspace-account__meta">
        <strong><%= currentUser?.displayName ?? 'Workspace User' %></strong>
        <span><%= currentUser?.email ?? '' %></span>
      </div>
      <% if (impersonation) { %>
        <button class="btn btn-sm btn-outline-warning" data-api-action="/api/v1/admin/impersonation/stop">Stop View As</button>
      <% } %>
      <button class="btn btn-sm btn-outline-light" data-api-action="/api/v1/auth/logout">Logout</button>
    </div>
  </div>
</header>
