<%- include('../partials/head', { title, csrfToken }) %>
<main class="auth-shell"><section class="auth-card">
  <h1 class="h3">Reset password</h1><p class="text-secondary">A reset link is sent only when the account exists.</p>
  <div class="form-message"></div>
  <form data-api-form action="/api/v1/auth/forgot-password" method="post">
    <input type="hidden" name="_csrf" value="<%= csrfToken %>">
    <label class="form-label">Email</label><input class="form-control mb-3" type="email" name="email" required>
    <button class="btn btn-primary w-100" type="submit">Send reset link</button>
  </form><a class="d-block mt-4 text-center" href="/login">Back to login</a>
</section></main>
<%- include('../partials/footer') %>
