<%- include('../partials/head', { title, csrfToken }) %>
<div class="workspace-shell">
  <%- include('../partials/user-topbar') %>
  <main
    class="workspace-main content-area"
    <% if (job) { %>data-job-stream="<%= job.id %>" data-job-type="<%= job.type %>"<% } %>>
    <% if (!job) { %>
      <header class="page-header">
        <div><span class="eyebrow">Jobs</span><h1>Job not found</h1><p>The requested job is unavailable in this workspace.</p></div>
        <a class="btn btn-outline-primary" href="/app/jobs">Back to jobs</a>
      </header>
    <% } else { %>
      <% const latestFailureEvent = events.find((event) => event.eventType === 'job.failed' || event.eventType === 'job.needs_review') ?? null; %>
      <% const latestWarningEvent = events.find((event) => event.eventType === 'job.warning') ?? null; %>
      <% 
        const displayProgressPercent =
          job.status === 'COMPLETED' || job.status === 'PARTIALLY_COMPLETED'
            ? 100
            : ['FAILED', 'CANCELED', 'NEEDS_REVIEW'].includes(job.status)
              ? Math.min(Math.max(job.progressPercent ?? 0, 0), 99)
              : Math.max(0, Math.min(100, job.progressPercent ?? 0));
        const stageGroups = {
          TTS_VALIDATION: 'Script validation',
          TTS_SEGMENTATION: 'Speech segmentation',
          TTS_AUDIO: 'Audio synthesis',
          SOURCE_PREP: 'Source preparation',
          AUDIO_TRANSCRIPT: 'Audio and transcript',
          CANDIDATE_ANALYSIS: 'Candidate analysis',
          RESULT_PREP: 'Result packaging',
          FINAL_RENDER: 'Final render',
          FINAL_REVIEW: 'Output validation',
          DELIVERY: 'Saving outputs'
        };
        const stageGroupKey = (name) => {
          if (name === 'VALIDATING_SCRIPT') return 'TTS_VALIDATION';
          if (name === 'GENERATING_SEGMENTS') return 'TTS_SEGMENTATION';
          if (name === 'GENERATING_AUDIO') return 'TTS_AUDIO';
          if (name === 'SAVING_OUTPUTS') return 'DELIVERY';
          if (name === 'VALIDATING_SOURCE' || name === 'PROBING_MEDIA') return 'SOURCE_PREP';
          if (name === 'EXTRACTING_AUDIO' || name === 'TRANSCRIBING') return 'AUDIO_TRANSCRIPT';
          if (name === 'DETECTING_SCENES' || name === 'DETECTING_SILENCE' || name === 'ANALYZING_CLIP_CANDIDATES' || name === 'NORMALIZING_BOUNDARIES' || name === 'RANKING_AND_DEDUPLICATING') return 'CANDIDATE_ANALYSIS';
          if (name === 'GENERATING_PREVIEWS' || name === 'GENERATING_METADATA') return 'RESULT_PREP';
          if (name === 'REFRAMING' || name === 'GENERATING_SUBTITLES' || name === 'RENDERING_FINAL_CLIPS') return 'FINAL_RENDER';
          if (name === 'QUALITY_CHECK') return 'FINAL_REVIEW';
          if (name === 'UPLOADING_OUTPUTS') return 'DELIVERY';
          return name;
        };
        const stageGroupLabel = (name) => stageGroups[stageGroupKey(name)] ?? name;
        const stageStatusPriority = { FAILED: 5, NEEDS_REVIEW: 4, RUNNING: 3, PAUSED: 2, PENDING: 1, COMPLETED: 0 };
        const groupedStagesMap = new Map();
        for (const stage of job.stages) {
          const key = stageGroupKey(stage.name);
          const existing = groupedStagesMap.get(key);
          if (!existing) {
            groupedStagesMap.set(key, {
              key,
              label: stageGroupLabel(stage.name),
              status: stage.status,
              progressPercent: stage.progressPercent,
              progressWeight: Number(stage.progressWeight),
              weightedProgress: stage.progressPercent * Number(stage.progressWeight)
            });
            continue;
          }
          const currentStatusPriority = stageStatusPriority[stage.status] ?? -1;
          const existingStatusPriority = stageStatusPriority[existing.status] ?? -1;
          existing.progressWeight += Number(stage.progressWeight);
          existing.weightedProgress += stage.progressPercent * Number(stage.progressWeight);
          existing.progressPercent = Math.round(existing.weightedProgress / Math.max(1, existing.progressWeight));
          if (currentStatusPriority > existingStatusPriority) {
            existing.status = stage.status;
          } else if (currentStatusPriority === existingStatusPriority && stage.progressPercent > existing.progressPercent) {
            existing.status = stage.status;
          }
        }
        const groupedStages = Array.from(groupedStagesMap.values());
        const displayStageLabel =
          ['COMPLETED', 'FAILED', 'CANCELED', 'PARTIALLY_COMPLETED', 'NEEDS_REVIEW'].includes(job.status)
            ? job.status
            : stageGroupLabel(job.currentStage ?? 'Unknown');
      %>
      <header class="page-header">
        <div>
          <span class="eyebrow">Async Job</span>
          <h1>Job Detail</h1>
          <p>
            ID: <code><%= job.id %></code><br>
            <small><%= job.type %> &middot; <%= job.project?.name ?? 'No project' %> &middot; <%= job.sourceMediaAsset?.displayName ?? 'No source linked' %></small>
          </p>
        </div>
        <div class="d-flex gap-2">
          <a class="btn btn-outline-primary" href="/app/dashboard">Kembali ke Dashboard</a>
          <% if (job.type === 'TEXT_TO_SPEECH') { %>
            <a class="btn btn-outline-secondary" href="/app/jobs/<%= job.id %>/tts-segmentation-export">Download segmentation JSON</a>
          <% } %>
          <% if (clipOutputs.length) { %>
            <a class="btn btn-outline-secondary" href="/app/jobs/<%= job.id %>/export-index">Download all index</a>
          <% } %>
          <% if (['QUEUED','RUNNING','PAUSED','PAUSE_REQUESTED'].includes(job.status)) { %>
            <form data-api-form action="/api/v1/jobs/<%= job.id %>/cancel" method="post"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><button class="btn btn-outline-danger" type="submit">Cancel</button></form>
          <% } %>
          <% if (['FAILED', 'NEEDS_REVIEW'].includes(job.status)) { %>
            <form data-api-form data-idempotency-key="true" action="/api/v1/jobs/<%= job.id %>/retry" method="post"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><input type="hidden" name="reason" value="Retry requested from job detail"><input type="hidden" name="stage" value="<%= job.currentStage ?? '' %>"><button class="btn btn-outline-warning" type="submit">Retry failed stage</button></form>
          <% } %>
          <% if (['DRAFT', 'FAILED', 'COMPLETED', 'PARTIALLY_COMPLETED', 'CANCELED', 'NEEDS_REVIEW'].includes(job.status)) { %>
            <form data-api-form data-confirm="Hapus job ini beserta artifact hasil generate di storage?" action="/api/v1/jobs/<%= job.id %>/delete" method="post"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><button class="btn btn-outline-danger" type="submit">Delete job</button></form>
          <% } %>
          <% if (job.type === 'AUTO_CLIPPING') { %>
            <form data-api-form data-idempotency-key="true" action="/api/v1/auto-clipping/jobs/<%= job.id %>/duplicate" method="post"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><button class="btn btn-outline-secondary" type="submit">Duplicate</button></form>
          <% } %>
        </div>
      </header>

      <section class="panel job-hero-panel">
        <div class="job-hero-panel__top">
          <div>
            <span class="status status-<%= job.status.toLowerCase() %>" data-job-status><%= job.status %></span>
            <div class="text-muted small mt-2">Current stage: <strong data-job-stage><%= displayStageLabel %></strong></div>
          </div>
          <div class="job-hero-panel__meta">
            <article><span>Attempts</span><strong><%= job.attempts.length %></strong></article>
            <article><span><%= job.type === 'TEXT_TO_SPEECH' ? 'Segments' : 'Outputs' %></span><strong><%= job.type === 'TEXT_TO_SPEECH' ? (outputSummary.tts?.segmentCount ?? 0) : clipOutputs.length %></strong></article>
            <article><span>Created</span><strong><%= job.createdAt.toLocaleString() %></strong></article>
          </div>
        </div>
        <div class="job-hero-progress">
          <div class="d-flex justify-content-between align-items-center gap-3 mb-2">
            <strong>Progress</strong>
            <strong data-job-progress-value-inline><%= displayProgressPercent %>%</strong>
          </div>
          <div class="progress progress-lg">
            <div class="progress-bar progress-bar-job" data-job-progress-bar style="width:<%= displayProgressPercent %>%"></div>
          </div>
        </div>
      </section>

      <% if (['COMPLETED', 'PARTIALLY_COMPLETED'].includes(job.status)) { %>
        <section class="panel mt-4">
          <div class="panel-heading">
            <div>
              <h2>Regenerate</h2>
              <p>Ubah input utama lalu jalankan ulang di job yang sama. Hasil sukses lama akan diganti dengan output baru.</p>
            </div>
          </div>
          <div class="p-4">
            <details>
              <summary>Show regenerate form</summary>
              <div class="form-message mt-3"></div>

              <% if (job.type === 'TEXT_TO_SPEECH' && outputSummary.ttsRequestSnapshot) { %>
                <form class="row g-3 mt-2" data-api-form data-idempotency-key="true" action="/api/v1/tts/jobs/<%= job.id %>/regenerate" method="post">
                  <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                  <div class="col-12">
                    <label class="form-label">Script</label>
                    <textarea class="form-control" name="script" rows="8" required><%= outputSummary.ttsRequestSnapshot.script ?? '' %></textarea>
                  </div>
                  <div class="col-md-3">
                    <label class="form-label">Language</label>
                    <input class="form-control" name="language" value="<%= outputSummary.ttsRequestSnapshot.language ?? 'id' %>" required>
                  </div>
                  <div class="col-md-3">
                    <label class="form-label">Local model key</label>
                    <input class="form-control" name="local_model_key" value="<%= outputSummary.ttsRequestSnapshot.localModelKey ?? '' %>">
                  </div>
                  <div class="col-md-3">
                    <label class="form-label">Voice identifier</label>
                    <input class="form-control" name="voice_identifier" value="<%= outputSummary.ttsRequestSnapshot.voiceIdentifier ?? '' %>">
                  </div>
                  <div class="col-md-3">
                    <label class="form-label">Speaking style</label>
                    <select class="form-select" name="speaking_style">
                      <option value="" <%= !outputSummary.ttsRequestSnapshot.speakingStyle ? 'selected' : '' %>>Auto</option>
                      <% ['NARRATION','CONVERSATIONAL','CALM','ENERGETIC','DRAMATIC','AUTHORITATIVE'].forEach((value) => { %>
                        <option value="<%= value %>" <%= outputSummary.ttsRequestSnapshot.speakingStyle === value ? 'selected' : '' %>><%= value %></option>
                      <% }) %>
                    </select>
                  </div>
                  <div class="col-md-3">
                    <label class="form-label">Emotion</label>
                    <select class="form-select" name="emotion">
                      <option value="" <%= !outputSummary.ttsRequestSnapshot.emotion ? 'selected' : '' %>>Auto</option>
                      <% ['neutral','curious','serious','dramatic','hopeful','sad','surprised','calm'].forEach((value) => { %>
                        <option value="<%= value %>" <%= outputSummary.ttsRequestSnapshot.emotion === value ? 'selected' : '' %>><%= value %></option>
                      <% }) %>
                    </select>
                  </div>
                  <div class="col-md-3">
                    <label class="form-label">Speaking speed</label>
                    <input class="form-control" name="speaking_speed" type="number" min="0.5" max="3" step="0.1" value="<%= outputSummary.ttsRequestSnapshot.speakingSpeed ?? '' %>">
                  </div>
                  <div class="col-md-3">
                    <label class="form-label">Pitch</label>
                    <input class="form-control" name="pitch" type="number" min="-20" max="20" step="0.1" value="<%= outputSummary.ttsRequestSnapshot.pitch ?? '' %>">
                  </div>
                  <div class="col-md-3">
                    <label class="form-label">Pause intensity</label>
                    <input class="form-control" name="pause_intensity" type="number" min="0" max="3" step="0.1" value="<%= outputSummary.ttsRequestSnapshot.pauseIntensity ?? '' %>">
                  </div>
                  <div class="col-md-3">
                    <label class="form-label">Target duration ms</label>
                    <input class="form-control" name="target_duration_ms" type="number" min="1" step="1" value="<%= outputSummary.ttsRequestSnapshot.targetDurationMs ?? '' %>">
                  </div>
                  <div class="col-md-3">
                    <label class="form-label">Preferred format</label>
                    <select class="form-select" name="preferred_format">
                      <% ['WAV','MP3','OGG'].forEach((format) => { %>
                        <option value="<%= format %>" <%= outputSummary.ttsRequestSnapshot.preferredFormat === format ? 'selected' : '' %>><%= format %></option>
                      <% }) %>
                    </select>
                  </div>
                  <div class="col-md-3">
                    <label class="form-label">Segmentation mode</label>
                    <select class="form-select" name="segmentation_mode">
                      <% ['LOCAL_HEURISTIC','OPENAI'].forEach((mode) => { %>
                        <option value="<%= mode %>" <%= outputSummary.ttsRequestSnapshot.segmentationMode === mode ? 'selected' : '' %>><%= mode %></option>
                      <% }) %>
                    </select>
                  </div>
                  <div class="col-md-3">
                    <label class="form-label">Sample rate</label>
                    <input class="form-control" name="sample_rate" type="number" min="8000" max="96000" step="1" value="<%= outputSummary.ttsRequestSnapshot.sampleRate ?? '' %>">
                  </div>
                  <div class="col-md-3">
                    <label class="form-label">Channels</label>
                    <input class="form-control" name="channels" type="number" min="1" max="2" step="1" value="<%= outputSummary.ttsRequestSnapshot.channels ?? '' %>">
                  </div>
                  <div class="col-md-6">
                    <label class="form-label">Tone notes</label>
                    <textarea class="form-control" name="tone_notes" rows="3"><%= outputSummary.ttsRequestSnapshot.userPreferences?.toneNotes ?? '' %></textarea>
                  </div>
                  <div class="col-md-6">
                    <label class="form-label">Delivery goal</label>
                    <textarea class="form-control" name="delivery_goal" rows="3"><%= outputSummary.ttsRequestSnapshot.userPreferences?.deliveryGoal ?? '' %></textarea>
                  </div>
                  <div class="col-md-3">
                    <label class="form-label">Segment length preference</label>
                    <select class="form-select" name="segment_length_preference">
                      <option value="">Use current default</option>
                      <% ['SHORT','BALANCED','LONG'].forEach((value) => { %>
                        <option value="<%= value %>" <%= outputSummary.ttsRequestSnapshot.userPreferences?.segmentLengthPreference === value ? 'selected' : '' %>><%= value %></option>
                      <% }) %>
                    </select>
                  </div>
                  <div class="col-md-3">
                    <label class="form-label">Breathing style</label>
                    <select class="form-select" name="breathing_style">
                      <option value="">Use current default</option>
                      <% ['MINIMAL','NATURAL','DRAMATIC'].forEach((value) => { %>
                        <option value="<%= value %>" <%= outputSummary.ttsRequestSnapshot.userPreferences?.breathingStyle === value ? 'selected' : '' %>><%= value %></option>
                      <% }) %>
                    </select>
                  </div>
                  <div class="col-12 d-flex justify-content-end">
                    <button class="btn btn-warning" type="submit">Regenerate and replace output</button>
                  </div>
                </form>
              <% } %>

              <% if (job.type === 'AUTO_CLIPPING' && outputSummary.requestSnapshot) { %>
                <form class="row g-3 mt-2" data-api-form data-idempotency-key="true" action="/api/v1/auto-clipping/jobs/<%= job.id %>/regenerate" method="post">
                  <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                  <div class="col-12">
                    <div class="candidate-caption-box">
                      <strong>Source tetap dipakai dari job ini</strong>
                      <p class="mb-0">
                        <%= outputSummary.requestSnapshot.sourceType === 'EXTERNAL_URL' ? 'External URL source' : 'Uploaded media asset' %>
                        <% if (job.sourceMediaAsset?.displayName) { %>| <%= job.sourceMediaAsset.displayName %><% } %>
                      </p>
                    </div>
                  </div>
                  <div class="col-md-6">
                    <label class="form-label">Content title</label>
                    <input class="form-control" name="content_title" value="<%= outputSummary.requestSnapshot.contentTitle ?? '' %>">
                  </div>
                  <div class="col-md-3">
                    <label class="form-label">Topic</label>
                    <input class="form-control" name="topic" value="<%= outputSummary.requestSnapshot.topic ?? '' %>">
                  </div>
                  <div class="col-md-3">
                    <label class="form-label">Source language</label>
                    <input class="form-control" name="source_language" value="<%= outputSummary.requestSnapshot.sourceLanguage ?? '' %>">
                  </div>
                  <div class="col-md-3">
                    <label class="form-label">Speaker count</label>
                    <input class="form-control" name="speaker_count" type="number" min="1" max="20" step="1" value="<%= outputSummary.requestSnapshot.speakerCount ?? '' %>">
                  </div>
                  <div class="col-md-3">
                    <label class="form-label">Target platform</label>
                    <select class="form-select" name="target_platform">
                      <% ['TIKTOK','INSTAGRAM_REELS','FACEBOOK_REELS','YOUTUBE_SHORTS','CUSTOM'].forEach((value) => { %>
                        <option value="<%= value %>" <%= outputSummary.requestSnapshot.strategy.targetPlatform === value ? 'selected' : '' %>><%= value %></option>
                      <% }) %>
                    </select>
                  </div>
                  <div class="col-md-3">
                    <label class="form-label">Objective</label>
                    <select class="form-select" name="objective">
                      <% ['ENGAGEMENT','EDUCATION','CONTROVERSY','STORYTELLING','PRODUCT_AWARENESS','LEAD_GENERATION'].forEach((value) => { %>
                        <option value="<%= value %>" <%= outputSummary.requestSnapshot.strategy.objective === value ? 'selected' : '' %>><%= value %></option>
                      <% }) %>
                    </select>
                  </div>
                  <div class="col-md-3">
                    <label class="form-label">Desired clip count</label>
                    <input class="form-control" name="desired_clip_count" type="number" min="1" max="30" step="1" value="<%= outputSummary.requestSnapshot.strategy.desiredClipCount ?? '' %>">
                  </div>
                  <div class="col-md-3">
                    <label class="form-label">Candidate pool</label>
                    <input class="form-control" name="candidate_pool_count" type="number" min="1" max="30" step="1" value="<%= outputSummary.requestSnapshot.strategy.candidatePoolCount ?? '' %>">
                  </div>
                  <div class="col-md-3">
                    <label class="form-label">Min duration</label>
                    <input class="form-control" name="minimum_duration_seconds" type="number" min="10" max="180" step="1" value="<%= outputSummary.requestSnapshot.strategy.minimumDurationSeconds ?? '' %>">
                  </div>
                  <div class="col-md-3">
                    <label class="form-label">Max duration</label>
                    <input class="form-control" name="maximum_duration_seconds" type="number" min="15" max="180" step="1" value="<%= outputSummary.requestSnapshot.strategy.maximumDurationSeconds ?? '' %>">
                  </div>
                  <div class="col-md-3">
                    <label class="form-label">Minimum viral score</label>
                    <input class="form-control" name="minimum_viral_score" type="number" min="0" max="10" step="0.1" value="<%= outputSummary.requestSnapshot.strategy.minimumViralScore ?? '' %>">
                  </div>
                  <div class="col-md-3">
                    <label class="form-label">Aspect ratio</label>
                    <select class="form-select" name="aspect_ratio">
                      <% ['9:16','1:1','4:5','16:9','CUSTOM'].forEach((value) => { %>
                        <option value="<%= value %>" <%= outputSummary.requestSnapshot.visual.aspectRatio === value ? 'selected' : '' %>><%= value %></option>
                      <% }) %>
                    </select>
                  </div>
                  <div class="col-md-3">
                    <label class="form-label">Crop strategy</label>
                    <select class="form-select" name="crop_strategy">
                      <% ['CENTER','ACTIVE_SPEAKER','FACE_TRACKING','AUTO_REFRAME','SPLIT_SCREEN','SPEAKER_AND_SCREEN','BLURRED_BACKGROUND','MANUAL'].forEach((value) => { %>
                        <option value="<%= value %>" <%= outputSummary.requestSnapshot.visual.cropStrategy === value ? 'selected' : '' %>><%= value %></option>
                      <% }) %>
                    </select>
                  </div>
                  <div class="col-md-3">
                    <label class="form-label">Layout template</label>
                    <select class="form-select" name="layout_template">
                      <% ['STANDARD','PODCAST_SPOTLIGHT_9X16'].forEach((value) => { %>
                        <option value="<%= value %>" <%= outputSummary.requestSnapshot.visual.layoutTemplate === value ? 'selected' : '' %>><%= value %></option>
                      <% }) %>
                    </select>
                  </div>
                  <div class="col-md-3 form-check d-flex align-items-end">
                    <div>
                      <input class="form-check-input" type="checkbox" name="subtitle_enabled" id="subtitle_enabled_regenerate" <%= outputSummary.requestSnapshot.subtitle.enabled !== false ? 'checked' : '' %>>
                      <label class="form-check-label" for="subtitle_enabled_regenerate">Subtitle enabled</label>
                    </div>
                  </div>
                  <div class="col-md-3 form-check d-flex align-items-end">
                    <div>
                      <input class="form-check-input" type="checkbox" name="subtitle_burn_in" id="subtitle_burn_in_regenerate" <%= outputSummary.requestSnapshot.subtitle.burnIn ? 'checked' : '' %>>
                      <label class="form-check-label" for="subtitle_burn_in_regenerate">Burn subtitle into video</label>
                    </div>
                  </div>
                  <div class="col-md-3 form-check d-flex align-items-end">
                    <div>
                      <input class="form-check-input" type="checkbox" name="require_spoken_audio" id="require_spoken_audio_regenerate" <%= outputSummary.requestSnapshot.strategy.requireSpokenAudio !== false ? 'checked' : '' %>>
                      <label class="form-check-label" for="require_spoken_audio_regenerate">Require spoken audio</label>
                    </div>
                  </div>
                  <div class="col-md-3 form-check d-flex align-items-end">
                    <div>
                      <input class="form-check-input" type="checkbox" name="remove_long_silence" id="remove_long_silence_regenerate" <%= outputSummary.requestSnapshot.strategy.removeLongSilence !== false ? 'checked' : '' %>>
                      <label class="form-check-label" for="remove_long_silence_regenerate">Remove long silence</label>
                    </div>
                  </div>
                  <div class="col-md-3 form-check d-flex align-items-end">
                    <div>
                      <input class="form-check-input" type="checkbox" name="remove_filler_words" id="remove_filler_words_regenerate" <%= outputSummary.requestSnapshot.strategy.removeFillerWords ? 'checked' : '' %>>
                      <label class="form-check-label" for="remove_filler_words_regenerate">Remove filler words</label>
                    </div>
                  </div>
                  <div class="col-md-3">
                    <label class="form-label">Standalone priority</label>
                    <select class="form-select" name="standalone_priority">
                      <% ['REQUIRED','PREFERRED','FLEXIBLE'].forEach((value) => { %>
                        <option value="<%= value %>" <%= outputSummary.requestSnapshot.strategy.standalonePriority === value ? 'selected' : '' %>><%= value %></option>
                      <% }) %>
                    </select>
                  </div>
                  <div class="col-md-3">
                    <label class="form-label">Profanity handling</label>
                    <select class="form-select" name="profanity_handling">
                      <% ['KEEP','MUTE','BLEEP','SUBTITLE_CENSOR'].forEach((value) => { %>
                        <option value="<%= value %>" <%= outputSummary.requestSnapshot.strategy.profanityHandling === value ? 'selected' : '' %>><%= value %></option>
                      <% }) %>
                    </select>
                  </div>
                  <div class="col-md-3">
                    <label class="form-label">Subtitle language</label>
                    <input class="form-control" name="subtitle_language" value="<%= outputSummary.requestSnapshot.subtitle.language ?? 'id' %>" required>
                  </div>
                  <div class="col-md-3">
                    <label class="form-label">Subtitle primary format</label>
                    <select class="form-select" name="subtitle_primary_format">
                      <% ['SRT','ASS','VTT','JSON'].forEach((value) => { %>
                        <option value="<%= value %>" <%= (outputSummary.requestSnapshot.subtitle.exportFormats[0] ?? 'ASS') === value ? 'selected' : '' %>><%= value %></option>
                      <% }) %>
                    </select>
                  </div>
                  <div class="col-md-3">
                    <label class="form-label">Subtitle position</label>
                    <select class="form-select" name="subtitle_position">
                      <option value="">Default</option>
                      <% ['TOP','CENTER','BOTTOM'].forEach((value) => { %>
                        <option value="<%= value %>" <%= outputSummary.requestSnapshot.subtitle.position === value ? 'selected' : '' %>><%= value %></option>
                      <% }) %>
                    </select>
                  </div>
                  <div class="col-md-3">
                    <label class="form-label">Subtitle max lines</label>
                    <input class="form-control" name="subtitle_max_lines" type="number" min="1" max="4" step="1" value="<%= outputSummary.requestSnapshot.subtitle.maxLines ?? '' %>">
                  </div>
                  <div class="col-md-6">
                    <label class="form-label">Content context</label>
                    <textarea class="form-control" name="content_context" rows="4"><%= outputSummary.requestSnapshot.contentContext ?? '' %></textarea>
                  </div>
                  <div class="col-md-6">
                    <label class="form-label">Custom vocabulary</label>
                    <textarea class="form-control" name="custom_vocabulary_text" rows="4"><%= outputSummary.requestSnapshot.customVocabulary.join(', ') %></textarea>
                  </div>
                  <div class="col-md-4">
                    <label class="form-label">Tones</label>
                    <textarea class="form-control" name="tones_text" rows="3"><%= outputSummary.requestSnapshot.strategy.tones.join(', ') %></textarea>
                    <select class="form-select mt-2" data-append-to-field="tones_text">
                      <option value="">Tambah tone preset...</option>
                      <% ['EDUCATIONAL','SERIOUS','DIRECT','CASUAL','CONTROVERSIAL','EMOTIONAL','CONFIDENT','URGENT'].forEach((value) => { %>
                        <option value="<%= value %>"><%= value %></option>
                      <% }) %>
                    </select>
                  </div>
                  <div class="col-md-4">
                    <label class="form-label">Preferred topics</label>
                    <textarea class="form-control" name="preferred_topics_text" rows="3"><%= outputSummary.requestSnapshot.strategy.preferredTopics.join(', ') %></textarea>
                  </div>
                  <div class="col-md-4">
                    <label class="form-label">Topics to avoid</label>
                    <textarea class="form-control" name="topics_to_avoid_text" rows="3"><%= outputSummary.requestSnapshot.strategy.topicsToAvoid.join(', ') %></textarea>
                  </div>
                  <div class="col-md-4">
                    <label class="form-label">Sensitive topics</label>
                    <textarea class="form-control" name="sensitive_topics_text" rows="3"><%= outputSummary.requestSnapshot.strategy.sensitiveTopics.join(', ') %></textarea>
                  </div>
                  <div class="col-md-4">
                    <label class="form-label">Clip style tags</label>
                    <textarea class="form-control" name="clip_style_tags_text" rows="3"><%= outputSummary.requestSnapshot.strategy.clipStyleTags.join(', ') %></textarea>
                    <select class="form-select mt-2" data-append-to-field="clip_style_tags_text">
                      <option value="">Tambah style preset...</option>
                      <% ['storytelling','educational','cinematic','shocking','podcast_insight','debate','commentary','case_study','quick_tips','emotional','direct_answer'].forEach((value) => { %>
                        <option value="<%= value %>"><%= value %></option>
                      <% }) %>
                    </select>
                  </div>
                  <div class="col-md-4">
                    <label class="form-label">Virality priorities</label>
                    <textarea class="form-control" name="virality_priorities_text" rows="3"><%= outputSummary.requestSnapshot.strategy.viralityPriorities.join(', ') %></textarea>
                    <select class="form-select mt-2" data-append-to-field="virality_priorities_text">
                      <option value="">Tambah virality preset...</option>
                      <% ['hook_0_2_detik','open_loop','konflik','shock_fact','punchline','comment_trigger','save_trigger','ending_utuh','high_retention_midpoint'].forEach((value) => { %>
                        <option value="<%= value %>"><%= value %></option>
                      <% }) %>
                    </select>
                  </div>
                  <div class="col-md-4">
                    <label class="form-label">Hook style</label>
                    <select class="form-select" name="hook_style">
                      <option value="" <%= !outputSummary.requestSnapshot.strategy.hookStyle ? 'selected' : '' %>>Auto</option>
                      <% ['QUESTION','SHOCK','DIRECT_CHALLENGE','STORY_OPEN','MYTH_BUSTING'].forEach((value) => { %>
                        <option value="<%= value %>" <%= outputSummary.requestSnapshot.strategy.hookStyle === value ? 'selected' : '' %>><%= value %></option>
                      <% }) %>
                    </select>
                  </div>
                  <div class="col-md-4">
                    <label class="form-label">CTA preference</label>
                    <select class="form-select" name="cta_preference">
                      <option value="" <%= !outputSummary.requestSnapshot.strategy.ctaPreference ? 'selected' : '' %>>Auto</option>
                      <% ['COMMENT','SHARE','FOLLOW','SAVE'].forEach((value) => { %>
                        <option value="<%= value %>" <%= outputSummary.requestSnapshot.strategy.ctaPreference === value ? 'selected' : '' %>><%= value %></option>
                      <% }) %>
                    </select>
                  </div>
                  <div class="col-md-4">
                    <label class="form-label">Subtitle export formats</label>
                    <input class="form-control" name="subtitle_export_formats_text" value="<%= outputSummary.requestSnapshot.subtitle.exportFormats.join(', ') %>">
                  </div>
                  <div class="col-md-4">
                    <label class="form-label">Subtitle style</label>
                    <select class="form-select" name="subtitle_style">
                      <option value="" <%= !outputSummary.requestSnapshot.subtitle.style ? 'selected' : '' %>>Auto / brand kit default</option>
                      <% ['DEFAULT','BOLD_KINETIC','CLEAN_MINIMAL','PODCAST_HIGHLIGHT','NEWS_FLASH','CINEMATIC_QUOTE'].forEach((value) => { %>
                        <option value="<%= value %>" <%= outputSummary.requestSnapshot.subtitle.style === value ? 'selected' : '' %>><%= value %></option>
                      <% }) %>
                    </select>
                  </div>
                  <div class="col-md-4">
                    <label class="form-label">Subtitle font family</label>
                    <input class="form-control" name="subtitle_font_family" value="<%= outputSummary.requestSnapshot.subtitle.fontFamily ?? '' %>">
                  </div>
                  <div class="col-md-4">
                    <label class="form-label">Selection brief</label>
                    <textarea class="form-control" name="selection_brief" rows="3"><%= outputSummary.requestSnapshot.strategy.selectionBrief ?? '' %></textarea>
                  </div>
                  <div class="col-md-6">
                    <label class="form-label">Avoidance brief</label>
                    <textarea class="form-control" name="avoidance_brief" rows="4"><%= outputSummary.requestSnapshot.strategy.avoidanceBrief ?? '' %></textarea>
                  </div>
                  <div class="col-md-6">
                    <label class="form-label">Packaging brief</label>
                    <textarea class="form-control" name="packaging_brief" rows="4"><%= outputSummary.requestSnapshot.strategy.packagingBrief ?? '' %></textarea>
                  </div>
                  <div class="col-12 d-flex justify-content-end">
                    <button class="btn btn-warning" type="submit">Regenerate and replace outputs</button>
                  </div>
                </form>
              <% } %>
            </details>
          </div>
        </section>
      <% } %>

      <section class="job-primary-grid mt-4">
        <div class="panel">
          <div class="panel-heading">
            <div><h2>Result</h2><p>Ringkasan analyzer dan hasil clip final untuk job ini.</p></div>
          </div>
          <div class="p-4">
            <div class="result-status-box">
              <strong>
                <% if (job.type === 'TEXT_TO_SPEECH') { %>
                  <%= outputSummary.tts?.segmentCount ?? 0 %> segmen narasi tersimpan<%= outputSummary.tts?.audioOutput?.playbackUrl ? ' + audio output siap diputar' : '' %>
                <% } else if (!clipOutputs.length && !candidates.length) { %>
                  Memuat hasil...
                <% } else if (!clipOutputs.length && candidates.length) { %>
                  Analisis kandidat sudah selesai, menunggu hasil render final.
                <% } else { %>
                  <%= clipOutputs.length %> output clip final tersimpan
                <% } %>
              </strong>
              <span>
                <% if (job.type === 'TEXT_TO_SPEECH') { %>
                  Segment plan TTS dan audio narration
                <% } else if (outputSummary.analysisVersion) { %>
                  Analyzer <%= outputSummary.analysisVersion %>
                <% } else { %>
                  Menunggu hasil pipeline
                <% } %>
              </span>
            </div>

            <div class="job-summary-grid mt-3">
              <% if (job.type === 'TEXT_TO_SPEECH') { %>
              <article class="job-summary-card"><span>Segments</span><strong><%= outputSummary.tts?.segmentCount ?? 0 %></strong></article>
              <article class="job-summary-card"><span>Total pauses</span><strong><%= outputSummary.tts?.totalPauseMs ? `${outputSummary.tts.totalPauseMs} ms` : '-' %></strong></article>
              <article class="job-summary-card"><span>Voice</span><strong><%= outputSummary.ttsRequestSnapshot?.localModelKey ?? outputSummary.ttsRequestSnapshot?.voiceIdentifier ?? outputSummary.ttsRequestSnapshot?.speakingStyle ?? '-' %></strong></article>
              <article class="job-summary-card"><span>Audio output</span><strong><%= outputSummary.tts?.audioOutput?.playbackUrl ? 'Ready' : 'Pending' %></strong></article>
              <% } else { %>
                <article class="job-summary-card"><span>Source duration</span><strong><%= outputSummary.estimatedUsage.sourceDurationSeconds ? `${outputSummary.estimatedUsage.sourceDurationSeconds}s` : '-' %></strong></article>
                <article class="job-summary-card"><span>Selected clips</span><strong><%= outputSummary.estimatedUsage.selectedCandidates %></strong></article>
                <article class="job-summary-card"><span>Clip outputs</span><strong><%= outputSummary.estimatedUsage.clipOutputs %></strong></article>
              <% } %>
              <article class="job-summary-card"><span>Workflow</span><strong><%= job.workflowId ?? '-' %></strong></article>
            </div>
          </div>
          <div class="px-4 pb-4" data-job-issue-panel>
            <% if (job.status === 'FAILED' && job.errors.length) { %>
              <div class="clip-output-warning-box mt-3" data-job-issue-box data-issue-kind="failure">
                <strong>Latest failure</strong>
                <ul>
                  <li><strong>Code:</strong> <%= job.errors[0].code %></li>
                  <li><strong>Category:</strong> <%= job.errors[0].category %></li>
                  <li><strong>User message:</strong> <%= job.errors[0].userMessage %></li>
                  <li><strong>Technical message:</strong> <%= job.errors[0].message %></li>
                  <li><strong>Occurred at:</strong> <%= job.errors[0].occurredAt.toLocaleString() %></li>
                </ul>
              </div>
            <% } else if (['FAILED', 'NEEDS_REVIEW'].includes(job.status) && latestFailureEvent) { %>
              <div class="clip-output-warning-box mt-3" data-job-issue-box data-issue-kind="workflow">
                <strong>Latest workflow issue</strong>
                <ul>
                  <li><strong>Type:</strong> <%= latestFailureEvent.eventType %></li>
                  <li><strong>Message:</strong> <%= latestFailureEvent.userMessage ?? latestFailureEvent.message %></li>
                  <li><strong>Technical detail:</strong> <%= latestFailureEvent.message %></li>
                  <li><strong>Occurred at:</strong> <%= latestFailureEvent.occurredAt.toLocaleString() %></li>
                </ul>
              </div>
            <% } else if (latestWarningEvent) { %>
              <div class="clip-output-warning-box mt-3" data-job-issue-box data-issue-kind="warning">
                <strong>Latest pipeline warning</strong>
                <ul>
                  <li><strong>Type:</strong> <%= latestWarningEvent.eventType %></li>
                  <li><strong>Message:</strong> <%= latestWarningEvent.userMessage ?? latestWarningEvent.message %></li>
                  <li><strong>Technical detail:</strong> <%= latestWarningEvent.message %></li>
                  <li><strong>Occurred at:</strong> <%= latestWarningEvent.occurredAt.toLocaleString() %></li>
                </ul>
              </div>
            <% } %>
          </div>
          <% if (job.type === 'AUTO_CLIPPING' && outputSummary.sourceSummary) { %>
            <div class="analyzer-summary pt-0">
              <h3>Source summary</h3>
              <p><%= outputSummary.sourceSummary %></p>
            </div>
          <% } %>
        </div>

        <aside class="panel">
          <div class="panel-heading">
            <div><h2>Logs</h2><p>Event terbaru dari workflow durable.</p></div>
          </div>
          <div class="job-log-list" data-job-events>
            <% if (!events.length) { %>
              <div class="empty-cell" data-job-events-empty>No events recorded yet.</div>
            <% } %>
            <% events.forEach((event) => { %>
              <article class="job-log-item">
                <strong>[<%= event.eventType %>]</strong>
                <span><%= event.occurredAt.toLocaleString() %></span>
                <p><%= event.userMessage ?? event.message %></p>
              </article>
            <% }) %>
          </div>
        </aside>
      </section>

      <% if (job.type === 'TEXT_TO_SPEECH') { %>
        <section class="panel mt-4">
          <div class="panel-heading">
            <div><h2>TTS segmentation</h2><p>Speech segment plan yang dihasilkan workflow untuk synthesis berikutnya.</p></div>
            <div class="d-flex gap-2 flex-wrap">
              <a class="btn btn-sm btn-outline-secondary" href="/app/jobs/<%= job.id %>/tts-segmentation-export">Export segmentation JSON</a>
              <% if (outputSummary.tts?.audioOutput?.playbackUrl) { %>
                <a class="btn btn-sm btn-outline-secondary" href="/app/jobs/<%= job.id %>/tts-output-export-index">Export TTS outputs</a>
              <% } %>
            </div>
          </div>
          <div class="p-4">
            <% if (outputSummary.tts?.audioOutput?.playbackUrl) { %>
              <div class="candidate-caption-box mb-3">
                <strong>Rendered narration preview</strong>
                <audio class="w-100 mt-2" controls preload="metadata" src="<%= outputSummary.tts.audioOutput.playbackUrl %>"></audio>
                <div class="text-muted small mt-2">
                  <% if (outputSummary.tts.audioOutput.durationMs) { %>
                    <span>Durasi <%= (outputSummary.tts.audioOutput.durationMs / 1000).toFixed(1) %> detik</span>
                  <% } %>
                  <% if (outputSummary.tts.audioOutput.sampleRate) { %>
                    <span><%= outputSummary.tts.audioOutput.durationMs ? ' | ' : '' %><%= outputSummary.tts.audioOutput.sampleRate %> Hz</span>
                  <% } %>
                  <% if (outputSummary.tts.audioOutput.extension) { %>
                    <span><%= (outputSummary.tts.audioOutput.durationMs || outputSummary.tts.audioOutput.sampleRate) ? ' | ' : '' %><%= String(outputSummary.tts.audioOutput.extension).toUpperCase() %></span>
                  <% } %>
                </div>
                <% if (outputSummary.tts.audioOutput.requestedFormat || outputSummary.tts.audioOutput.actualFormat) { %>
                  <div class="text-muted small mt-2">
                    Requested format: <strong><%= String(outputSummary.tts.audioOutput.requestedFormat ?? '-').toUpperCase() %></strong>
                    <% if (outputSummary.tts.audioOutput.actualFormat) { %>
                      | Final format: <strong><%= String(outputSummary.tts.audioOutput.actualFormat).toUpperCase() %></strong>
                    <% } %>
                  </div>
                <% } %>
                <% if (outputSummary.tts.audioOutput.fallbackUsed) { %>
                  <div class="clip-output-warning-box mt-3">
                    <strong>Format fallback applied</strong>
                    <ul>
                      <li>Format yang diminta tidak berhasil dirender, jadi output otomatis disimpan sebagai WAV agar job tetap selesai.</li>
                      <% if (outputSummary.tts.audioOutput.fallbackReason) { %>
                        <li><strong>Reason:</strong> <%= outputSummary.tts.audioOutput.fallbackReason %></li>
                      <% } %>
                    </ul>
                  </div>
                <% } %>
                <div class="d-flex flex-wrap gap-2 mt-3">
                  <a class="btn btn-sm btn-primary" href="/app/jobs/<%= job.id %>/tts-audio-download" target="_blank" rel="noreferrer">Open audio</a>
                  <a class="btn btn-sm btn-outline-secondary" href="/app/jobs/<%= job.id %>/tts-audio-download">Download audio</a>
                  <a class="btn btn-sm btn-outline-secondary" href="/app/jobs/<%= job.id %>/tts-output-export-index">Export output index</a>
                </div>
              </div>
            <% } %>

            <div class="job-summary-grid mb-3">
              <article class="job-summary-card"><span>Language</span><strong><%= outputSummary.ttsRequestSnapshot?.language ?? '-' %></strong></article>
              <article class="job-summary-card"><span>Local model</span><strong><%= outputSummary.ttsRequestSnapshot?.localModelKey ?? '-' %></strong></article>
              <article class="job-summary-card"><span>Segmentation mode</span><strong><%= outputSummary.ttsRequestSnapshot?.segmentationMode ?? '-' %></strong></article>
              <article class="job-summary-card"><span>Style</span><strong><%= outputSummary.ttsRequestSnapshot?.speakingStyle ?? '-' %></strong></article>
              <article class="job-summary-card"><span>Emotion</span><strong><%= outputSummary.ttsRequestSnapshot?.emotion ?? '-' %></strong></article>
              <article class="job-summary-card"><span>Target duration</span><strong><%= outputSummary.ttsRequestSnapshot?.targetDurationMs ? `${outputSummary.ttsRequestSnapshot.targetDurationMs} ms` : '-' %></strong></article>
              <article class="job-summary-card"><span>Format</span><strong><%= outputSummary.ttsRequestSnapshot?.preferredFormat ?? '-' %></strong></article>
              <article class="job-summary-card"><span>Sample rate</span><strong><%= outputSummary.ttsRequestSnapshot?.sampleRate ?? '-' %></strong></article>
              <article class="job-summary-card"><span>Average pause</span><strong><%= outputSummary.tts?.averagePauseMs ? `${outputSummary.tts.averagePauseMs} ms` : '-' %></strong></article>
            </div>

            <% if (outputSummary.ttsRequestSnapshot?.segmentationMode === 'LOCAL_HEURISTIC') { %>
              <div class="candidate-caption-box mb-3">
                <strong>Testing mode aktif</strong>
                <p class="mb-0">Job ini memakai segmentasi lokal heuristic, jadi pembagian segmen narasi dibuat di worker tanpa request ke OpenAI.</p>
              </div>
            <% } %>

            <% if (outputSummary.ttsRequestSnapshot?.userPreferences?.deliveryGoal) { %>
              <div class="candidate-caption-box mb-3">
                <strong>Delivery goal</strong>
                <p><%= outputSummary.ttsRequestSnapshot.userPreferences.deliveryGoal %></p>
              </div>
            <% } %>
            <% if (outputSummary.ttsRequestSnapshot?.userPreferences?.toneNotes) { %>
              <div class="candidate-caption-box mb-3">
                <strong>Tone notes</strong>
                <p><%= outputSummary.ttsRequestSnapshot.userPreferences.toneNotes %></p>
              </div>
            <% } %>

            <% if (outputSummary.tts?.metadata) { %>
              <div class="clip-output-review-grid mb-3">
                <article class="clip-output-review-card">
                  <span>Provider</span>
                  <strong><%= outputSummary.tts.metadata.provider ?? '-' %></strong>
                  <p><%= outputSummary.tts.metadata.model ?? 'Model tidak tersimpan.' %></p>
                </article>
                <article class="clip-output-review-card">
                  <span>Prompt version</span>
                  <strong><%= outputSummary.tts.metadata.promptVersion ?? '-' %></strong>
                  <p><%= outputSummary.tts.metadata.latencyMs ? `${outputSummary.tts.metadata.latencyMs} ms latency` : 'Latency belum tersedia.' %></p>
                </article>
                <article class="clip-output-review-card">
                  <span>Request IDs</span>
                  <strong><%= outputSummary.tts.metadata.providerRequestId ?? '-' %></strong>
                  <p><%= outputSummary.tts.metadata.requestId ?? 'Request id internal belum tersedia.' %></p>
                </article>
              </div>
            <% } %>

            <% if (outputSummary.tts?.previewSegments?.length) { %>
              <div class="candidate-caption-box mb-3">
                <strong>Quick preview</strong>
                <p>Lima segmen pertama ditampilkan langsung untuk cek pacing dan gaya delivery dengan cepat.</p>
              </div>
              <div class="candidate-grid candidate-grid--single">
                <% outputSummary.tts.previewSegments.forEach((segment) => { %>
                  <article class="candidate-card candidate-card--result">
                    <div class="candidate-result-header">
                      <div>
                        <h3>Segment #<%= segment.id ?? '-' %></h3>
                        <div class="text-muted small"><%= segment.emotion ?? '-' %> · <%= segment.speed ?? '-' %> · <%= segment.emphasis ?? '-' %></div>
                      </div>
                      <div class="candidate-score-badge"><%= segment.pauseAfter ? `${segment.pauseAfter} ms pause` : 'Pause -' %></div>
                    </div>
                    <p class="candidate-summary mb-0"><%= segment.text %></p>
                  </article>
                <% }) %>
              </div>

              <% if (outputSummary.tts.fullSegments?.length) { %>
                <details class="candidate-caption-box mt-3">
                  <summary><strong>Show full segmentation plan</strong> <span class="text-muted">(<%= outputSummary.tts.fullSegments.length %> segments)</span></summary>
                  <div class="candidate-grid candidate-grid--single mt-3">
                    <% outputSummary.tts.fullSegments.forEach((segment) => { %>
                      <article class="candidate-card candidate-card--result">
                        <div class="candidate-result-header">
                          <div>
                            <h3>Segment #<%= segment.id ?? '-' %></h3>
                            <div class="text-muted small"><%= segment.emotion ?? '-' %> Â· <%= segment.speed ?? '-' %> Â· <%= segment.emphasis ?? '-' %> Â· <%= segment.volume ?? '-' %></div>
                          </div>
                          <div class="candidate-score-badge"><%= segment.pauseAfter ? `${segment.pauseAfter} ms pause` : 'Pause -' %></div>
                        </div>
                        <p class="candidate-summary"><%= segment.text %></p>
                        <div class="text-muted small">
                          Breath before: <strong><%= segment.breathBefore === null ? '-' : (segment.breathBefore ? 'yes' : 'no') %></strong>
                          Â· Breath after: <strong><%= segment.breathAfter === null ? '-' : (segment.breathAfter ? 'yes' : 'no') %></strong>
                          Â· Fade in: <strong><%= segment.fadeInMs ?? '-' %> ms</strong>
                          Â· Fade out: <strong><%= segment.fadeOutMs ?? '-' %> ms</strong>
                        </div>
                      </article>
                    <% }) %>
                  </div>
                </details>
              <% } %>
            <% } else { %>
              <div class="empty-cell">Belum ada segment plan yang tersimpan untuk job ini.</div>
            <% } %>
          </div>
        </section>
      <% } %>

      <% if (job.type === 'AUTO_CLIPPING') { %>
      <section class="panel mt-4">
        <div class="panel-heading">
          <div><h2>Analyzer run</h2><p>Metadata analisis dari pipeline clipping.</p></div>
        </div>
        <div class="analyzer-grid">
          <article class="analyzer-card"><span>Analysis version</span><strong><%= outputSummary.analysisVersion ?? '-' %></strong></article>
          <article class="analyzer-card"><span>Mode</span><strong><%= outputSummary.analyzer?.analysisMode ?? '-' %></strong></article>
          <article class="analyzer-card"><span>Provider</span><strong><%= outputSummary.analyzer?.provider ?? '-' %></strong></article>
          <article class="analyzer-card"><span>Model</span><strong><%= outputSummary.analyzer?.model ?? '-' %></strong></article>
          <article class="analyzer-card"><span>Prompt version</span><strong><%= outputSummary.analyzer?.promptVersion ?? '-' %></strong></article>
          <article class="analyzer-card"><span>Latency</span><strong><%= outputSummary.analyzer?.latencyMs ? `${outputSummary.analyzer.latencyMs} ms` : '-' %></strong></article>
        </div>
      </section>

      <% if (outputSummary.requestSnapshot) { %>
        <section class="panel mt-4">
          <div class="panel-heading">
            <div><h2>Strategy snapshot</h2><p>Brief, target, dan pengaturan yang benar-benar dipakai saat job ini dibuat.</p></div>
          </div>
          <div class="p-4">
            <div class="job-summary-grid mb-3">
              <article class="job-summary-card"><span>Platform</span><strong><%= outputSummary.requestSnapshot.strategy.targetPlatform ?? '-' %></strong></article>
              <article class="job-summary-card"><span>Objective</span><strong><%= outputSummary.requestSnapshot.strategy.objective ?? '-' %></strong></article>
              <article class="job-summary-card"><span>Duration</span><strong><%= outputSummary.requestSnapshot.strategy.minimumDurationSeconds && outputSummary.requestSnapshot.strategy.maximumDurationSeconds ? `${outputSummary.requestSnapshot.strategy.minimumDurationSeconds}-${outputSummary.requestSnapshot.strategy.maximumDurationSeconds}s` : '-' %></strong></article>
              <article class="job-summary-card"><span>Visual</span><strong><%= outputSummary.requestSnapshot.visual.aspectRatio ?? '-' %> / <%= outputSummary.requestSnapshot.visual.cropStrategy ?? '-' %></strong></article>
              <article class="job-summary-card"><span>Candidate pool</span><strong><%= outputSummary.requestSnapshot.strategy.candidatePoolCount ?? '-' %></strong></article>
              <article class="job-summary-card"><span>Standalone</span><strong><%= outputSummary.requestSnapshot.strategy.standalonePriority ?? '-' %></strong></article>
            </div>

            <% if (outputSummary.requestSnapshot.contentTitle || outputSummary.requestSnapshot.topic) { %>
              <div class="candidate-caption-box mb-3">
                <% if (outputSummary.requestSnapshot.contentTitle) { %><p><strong>Title:</strong> <%= outputSummary.requestSnapshot.contentTitle %></p><% } %>
                <% if (outputSummary.requestSnapshot.topic) { %><p class="mb-0"><strong>Topic:</strong> <%= outputSummary.requestSnapshot.topic %></p><% } %>
              </div>
            <% } %>

            <% if (outputSummary.requestSnapshot.contentContext) { %>
              <div class="candidate-caption-box mb-3">
                <strong>Analysis brief</strong>
                <p><%= outputSummary.requestSnapshot.contentContext %></p>
              </div>
            <% } %>

            <div class="clip-output-review-grid">
              <article class="clip-output-review-card">
                <span>Preferred topics</span>
                <strong><%= outputSummary.requestSnapshot.strategy.preferredTopics.length %> item</strong>
                <p><%= outputSummary.requestSnapshot.strategy.preferredTopics.length ? outputSummary.requestSnapshot.strategy.preferredTopics.join(', ') : 'Tidak ada topic boost khusus.' %></p>
              </article>
              <article class="clip-output-review-card">
                <span>Topics to avoid</span>
                <strong><%= outputSummary.requestSnapshot.strategy.topicsToAvoid.length %> item</strong>
                <p><%= outputSummary.requestSnapshot.strategy.topicsToAvoid.length ? outputSummary.requestSnapshot.strategy.topicsToAvoid.join(', ') : 'Tidak ada area avoid khusus.' %></p>
              </article>
              <article class="clip-output-review-card">
                <span>Sensitive topics</span>
                <strong><%= outputSummary.requestSnapshot.strategy.sensitiveTopics.length %> item</strong>
                <p><%= outputSummary.requestSnapshot.strategy.sensitiveTopics.length ? outputSummary.requestSnapshot.strategy.sensitiveTopics.join(', ') : 'Tidak ada label sensitif tambahan.' %></p>
              </article>
              <article class="clip-output-review-card">
                <span>Clip styles</span>
                <strong><%= outputSummary.requestSnapshot.strategy.clipStyleTags.length %> item</strong>
                <p><%= outputSummary.requestSnapshot.strategy.clipStyleTags.length ? outputSummary.requestSnapshot.strategy.clipStyleTags.join(', ') : 'Tidak ada style khusus.' %></p>
              </article>
              <article class="clip-output-review-card">
                <span>Virality priorities</span>
                <strong><%= outputSummary.requestSnapshot.strategy.viralityPriorities.length %> item</strong>
                <p><%= outputSummary.requestSnapshot.strategy.viralityPriorities.length ? outputSummary.requestSnapshot.strategy.viralityPriorities.join(', ') : 'Pakai heuristik viral default.' %></p>
              </article>
              <article class="clip-output-review-card">
                <span>Subtitle plan</span>
                <strong><%= outputSummary.requestSnapshot.subtitle.language ?? '-' %></strong>
                <p><%= outputSummary.requestSnapshot.subtitle.exportFormats.length ? outputSummary.requestSnapshot.subtitle.exportFormats.join(', ') : 'Format subtitle belum diset.' %></p>
              </article>
            </div>

            <% if (outputSummary.requestSnapshot.strategy.selectionBrief) { %>
              <div class="candidate-caption-box mt-3">
                <strong>Selection brief</strong>
                <p><%= outputSummary.requestSnapshot.strategy.selectionBrief %></p>
              </div>
            <% } %>
            <% if (outputSummary.requestSnapshot.strategy.avoidanceBrief) { %>
              <div class="candidate-caption-box mt-3">
                <strong>Avoidance brief</strong>
                <p><%= outputSummary.requestSnapshot.strategy.avoidanceBrief %></p>
              </div>
            <% } %>
            <% if (outputSummary.requestSnapshot.strategy.packagingBrief) { %>
              <div class="candidate-caption-box mt-3">
                <strong>Packaging brief</strong>
                <p><%= outputSummary.requestSnapshot.strategy.packagingBrief %></p>
              </div>
            <% } %>

            <% if (outputSummary.requestSnapshot.customVocabulary.length) { %>
              <div class="candidate-tags mt-3">
                <% outputSummary.requestSnapshot.customVocabulary.forEach((term) => { %>
                  <span><%= term %></span>
                <% }) %>
              </div>
            <% } %>
          </div>
        </section>
      <% } %>
      <% } %>

      <section class="panel mt-4">
        <div class="panel-heading">
          <div><h2>Clip outputs</h2><p>Hasil render, subtitle, metadata, dan file yang siap didownload.</p></div>
          <% if (clipOutputs.length) { %>
            <a class="btn btn-sm btn-outline-secondary" href="/app/jobs/<%= job.id %>/export-index">Export all outputs</a>
          <% } %>
        </div>
        <div class="clip-output-stack">
          <%
            const finalReadyCount = clipOutputs.filter((output) => output.finalAvailable).length;
            const subtitleReadyCount = clipOutputs.filter((output) => output.subtitleAvailable).length;
            const warningCount = clipOutputs.filter((output) => output.validationWarnings.length > 0).length;
            const playableCount = clipOutputs.filter((output) => output.outputPlayable === true).length;
            const featuredOutput =
              clipOutputs.find((output) => output.finalAvailable && output.outputPlayable === true)
              ?? clipOutputs.find((output) => output.finalAvailable)
              ?? clipOutputs.find((output) => output.previewAvailable)
              ?? clipOutputs[0]
              ?? null;
          %>
          <% if (clipOutputs.length) { %>
            <div class="job-summary-grid">
              <article class="job-summary-card"><span>Total outputs</span><strong><%= clipOutputs.length %></strong></article>
              <article class="job-summary-card"><span>Playable</span><strong><%= playableCount %></strong></article>
              <article class="job-summary-card"><span>Final videos</span><strong><%= finalReadyCount %></strong></article>
              <article class="job-summary-card"><span>Subtitle ready</span><strong><%= subtitleReadyCount %></strong></article>
            </div>
            <% if (warningCount > 0) { %>
              <div class="clip-output-warning-box">
                <strong>Output warnings</strong>
                <ul>
                  <li><%= warningCount %> clip output masih punya warning validation/render yang perlu direview.</li>
                </ul>
              </div>
            <% } %>
            <% if (featuredOutput) { %>
              <div class="publish-actions-card" data-featured-output-summary>
                <div class="clip-output-featured-header">
                  <div>
                    <strong>Best output saat ini</strong>
                    <p>
                      <%= featuredOutput.candidateTitle ?? `Clip Output ${featuredOutput.id.slice(0, 8)}` %>
                      <% if (featuredOutput.aspectRatio) { %>| <%= featuredOutput.aspectRatio %><% } %>
                      <% if (featuredOutput.durationMs) { %>| <%= Number(featuredOutput.durationMs) / 1000 %> detik<% } %>
                    </p>
                  </div>
                  <span class="status status-<%= String(featuredOutput.qualityStatus).toLowerCase() %>"><%= featuredOutput.qualityStatus %></span>
                </div>
                <div class="d-flex flex-wrap gap-2">
                  <% if (featuredOutput.finalPlaybackUrl) { %>
                    <a class="btn btn-primary" href="<%= featuredOutput.finalPlaybackUrl %>" target="_blank" rel="noreferrer">Open best video</a>
                  <% } else if (featuredOutput.previewPlaybackUrl) { %>
                    <a class="btn btn-primary" href="<%= featuredOutput.previewPlaybackUrl %>" target="_blank" rel="noreferrer">Open best preview</a>
                  <% } %>
                  <% if (featuredOutput.finalAvailable) { %>
                    <a class="btn btn-success" href="/app/jobs/<%= job.id %>/outputs/<%= featuredOutput.id %>/download?artifact=final">Download best video</a>
                  <% } %>
                  <% if (featuredOutput.subtitleAvailable && featuredOutput.subtitleDownloads.length) { %>
                    <a class="btn btn-outline-secondary" href="/app/jobs/<%= job.id %>/outputs/<%= featuredOutput.id %>/download?artifact=<%= featuredOutput.subtitleDownloads[0].artifact %>">Download main subtitle</a>
                  <% } %>
                  <a class="btn btn-outline-secondary" href="/app/jobs/<%= job.id %>/outputs/<%= featuredOutput.id %>/export-index">Export best output index</a>
                </div>
              </div>
            <% } %>
          <% } %>
          <% if (!clipOutputs.length) { %>
            <div class="empty-cell">No rendered clip outputs have been stored yet.</div>
          <% } %>
          <% clipOutputs.forEach((output, index) => { %>
            <article
              class="clip-output-card <%= featuredOutput && featuredOutput.id === output.id ? 'clip-output-card--featured' : '' %>"
              <% if (featuredOutput && featuredOutput.id === output.id) { %>data-featured-clip-output tabindex="-1"<% } %>>
              <div class="clip-output-card__header">
                <div>
                  <h3>#<%= index + 1 %> - <%= output.candidateTitle ?? `Clip Output ${output.id.slice(0, 8)}` %></h3>
                  <div class="text-muted small"><%= output.aspectRatio ?? '-' %> | <%= output.width && output.height ? `${output.width}x${output.height}` : 'Pending dimensions' %> | <%= output.durationMs ? `${Number(output.durationMs) / 1000} detik` : '-' %></div>
                </div>
                <div class="d-flex flex-wrap gap-2 align-items-center">
                  <% if (featuredOutput && featuredOutput.id === output.id) { %>
                    <span class="clip-output-featured-badge">Best output</span>
                  <% } %>
                  <span class="status status-<%= String(output.qualityStatus).toLowerCase() %>"><%= output.qualityStatus %></span>
                </div>
              </div>
              <% if (output.suggestedCaption) { %>
                <div class="candidate-caption-box">
                  <strong>Caption rekomendasi:</strong>
                  <p><%= output.suggestedCaption %></p>
                </div>
              <% } %>
              <% if (output.previewPlaybackUrl || output.finalPlaybackUrl) { %>
                <div class="candidate-caption-box mb-3">
                  <strong>Video preview</strong>
                  <video
                    class="clip-output-preview-video"
                    controls
                    preload="metadata"
                    playsinline
                    src="<%= output.previewPlaybackUrl ?? output.finalPlaybackUrl %>"></video>
                  <p class="mt-2 mb-0 text-muted small">
                    <% if (output.previewPlaybackUrl) { %>
                      Player memakai artifact preview agar review lebih cepat.
                    <% } else { %>
                      Player memakai final output karena preview belum tersedia.
                    <% } %>
                  </p>
                </div>
              <% } %>
              <% if (output.retentionLevel) { %>
                <div class="text-muted small mb-2">Retention: <strong><%= output.retentionLevel %></strong></div>
              <% } %>
              <div class="candidate-tags mb-3">
                <% if (output.previewAvailable) { %><span>Preview</span><% } %>
                <% if (output.finalAvailable) { %><span>Final video</span><% } %>
                <% if (output.subtitleAvailable) { %><span>Subtitle <%= output.subtitleFormats.join(', ') %></span><% } %>
                <% if (output.metadataAvailable) { %><span>Metadata</span><% } %>
                <% if (output.validationStatus) { %><span>Validation <%= output.validationStatus %></span><% } %>
              </div>
              <div class="clip-output-review-grid mb-3">
                <article class="clip-output-review-card">
                  <span>Validation</span>
                  <strong><%= output.validationStatus ?? 'Pending review' %></strong>
                  <p><%= output.renderStatus ?? 'Render status belum tersedia.' %></p>
                </article>
                <article class="clip-output-review-card">
                  <span>Playback</span>
                  <strong><%= output.outputPlayable === true ? 'Playable' : output.outputPlayable === false ? 'Check needed' : 'Unknown' %></strong>
                  <p>
                    <% if (output.previewAvailable) { %>
                      Preview <%= output.previewPlayable === true ? 'ready' : output.previewPlayable === false ? 'needs review' : 'pending' %>
                    <% } else { %>
                      Preview video terpisah dilewati untuk menghemat storage.
                    <% } %>
                  </p>
                </article>
                <article class="clip-output-review-card">
                  <span>Codec</span>
                  <strong><%= output.finalVideoCodec ?? 'Unknown' %> / <%= output.finalAudioCodec ?? 'Unknown' %></strong>
                  <p><%= output.videoCodecMatchesTarget === true && output.audioCodecMatchesTarget === true ? 'Target codec matched' : 'Review codec target' %></p>
                </article>
                <article class="clip-output-review-card">
                  <span>Subtitle cues</span>
                  <strong><%= output.subtitleCueCount ?? 0 %></strong>
                  <p><%= output.subtitleExportReady === true ? 'Export siap dipakai' : 'Subtitle export belum siap' %></p>
                </article>
              </div>
              <div class="candidate-tags mb-3">
                <span><%= output.resolutionMatchesTarget === true ? 'Resolution OK' : output.resolutionMatchesTarget === false ? 'Resolution review' : 'Resolution pending' %></span>
                <span><%= output.audioPresent === true ? 'Audio OK' : output.audioPresent === false ? 'Audio missing' : 'Audio pending' %></span>
                <span><%= output.durationWithinTolerance === true ? 'Duration OK' : output.durationWithinTolerance === false ? 'Duration review' : 'Duration pending' %></span>
                <% if (output.finalDurationMs) { %><span>Final <%= Number(output.finalDurationMs) / 1000 %>s</span><% } %>
                <% if (output.previewDurationMs) { %><span>Preview <%= Number(output.previewDurationMs) / 1000 %>s</span><% } %>
              </div>
              <% if (output.validationWarnings.length) { %>
                <div class="clip-output-warning-box mb-3">
                  <strong>Warning render</strong>
                  <ul>
                    <% output.validationWarnings.forEach((warning) => { %>
                      <li><%= warning %></li>
                    <% }) %>
                  </ul>
                </div>
              <% } %>
              <div class="clip-output-action-groups">
                <div class="clip-output-action-group">
                  <span>Video</span>
                  <div class="d-flex flex-wrap gap-2">
                <% if (output.finalPlaybackUrl) { %>
                  <a class="btn btn-sm btn-primary" href="<%= output.finalPlaybackUrl %>" target="_blank" rel="noreferrer">Open video</a>
                <% } else if (output.previewPlaybackUrl) { %>
                  <a class="btn btn-sm btn-primary" href="<%= output.previewPlaybackUrl %>" target="_blank" rel="noreferrer">Open preview</a>
                <% } %>
                <% if (output.previewAvailable) { %>
                  <a class="btn btn-sm btn-outline-primary" href="/app/jobs/<%= job.id %>/outputs/<%= output.id %>/download?artifact=preview">Preview</a>
                <% } %>
                <% if (output.finalAvailable) { %>
                  <a class="btn btn-sm btn-success" href="/app/jobs/<%= job.id %>/outputs/<%= output.id %>/download?artifact=final">Download video</a>
                <% } %>
                  </div>
                </div>
                <% if (output.subtitleAvailable) { %>
                  <div class="clip-output-action-group">
                    <span>Subtitle</span>
                    <div class="d-flex flex-wrap gap-2">
                  <% output.subtitleDownloads.forEach((subtitle) => { %>
                    <a class="btn btn-sm btn-outline-secondary" href="/app/jobs/<%= job.id %>/outputs/<%= output.id %>/download?artifact=<%= subtitle.artifact %>">
                      Subtitle <%= subtitle.label %>
                    </a>
                  <% }) %>
                    </div>
                  </div>
                <% } %>
                <div class="clip-output-action-group">
                  <span>Assets</span>
                  <div class="d-flex flex-wrap gap-2">
                    <% if (output.metadataAvailable) { %>
                      <a class="btn btn-sm btn-outline-secondary" href="/app/jobs/<%= job.id %>/outputs/<%= output.id %>/download?artifact=metadata">Metadata</a>
                    <% } %>
                    <a class="btn btn-sm btn-outline-secondary" href="/app/jobs/<%= job.id %>/outputs/<%= output.id %>/export-index">Export index</a>
                    <form data-api-form action="/api/v1/jobs/<%= job.id %>/outputs/<%= output.id %>/rerender" method="post">
                      <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                      <button class="btn btn-sm btn-outline-warning" type="submit">Rerender</button>
                    </form>
                  </div>
                </div>
              </div>
              <div class="publish-actions-card mt-3">
                <div>
                  <strong>Download siap pakai</strong>
                  <p>Untuk sekarang output difokuskan ke render final, subtitle, dan metadata agar storage lebih hemat. Publish otomatis ke platform akan diaktifkan terpisah setelah integrasi kredensial selesai.</p>
                </div>
              </div>
              <% if (output.subtitleAvailable) { %>
                <div class="text-muted small mt-3">
                  Subtitle tersedia:
                  <%= output.subtitleDownloads.map((subtitle) => `${subtitle.label}${subtitle.language ? ` (${subtitle.language})` : ''}${subtitle.isBurnedIn ? ' burned-in' : ''}`).join(', ') %>
                </div>
              <% } %>
            </article>
          <% }) %>
        </div>
      </section>

      <section class="panel mt-4">
        <div class="panel-heading">
          <div><h2>Technical stages</h2><p>Detail teknis pipeline disembunyikan default supaya halaman user lebih ringkas.</p></div>
        </div>
        <details>
          <summary>Lihat fase pipeline</summary>
          <div class="table-responsive mt-3">
            <table class="table align-middle">
              <thead><tr><th>Phase</th><th>Status</th><th>Progress</th><th>Weight</th></tr></thead>
              <tbody>
                <% if (!groupedStages.length) { %>
                  <tr><td colspan="4" class="empty-cell">No stage projection yet.</td></tr>
                <% } %>
                <% groupedStages.forEach((stage) => { %>
                  <tr data-stage-row="<%= stage.key %>">
                    <td><strong><%= stage.label %></strong></td>
                    <td><span class="status status-<%= stage.status.toLowerCase() %>" data-stage-status><%= stage.status %></span></td>
                    <td data-stage-progress><%= stage.progressPercent %>%</td>
                    <td><%= Number(stage.progressWeight).toString() %></td>
                  </tr>
                <% }) %>
              </tbody>
            </table>
          </div>
        </details>
      </section>

    <% } %>
  </main>
</div>
<%- include('../partials/footer') %>
