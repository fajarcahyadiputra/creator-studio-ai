<%- include('../partials/head', { title, csrfToken }) %>
<div class="workspace-shell"><%- include('../partials/user-topbar') %><main class="workspace-main content-area">
  <header class="page-header">
    <div>
      <span class="eyebrow">Reusable setup</span>
      <h1>Templates & Presets</h1>
      <p>Simpan template strategi clipping dan brand kit supaya job baru tinggal pilih preset, tanpa isi ulang field yang sama berulang-ulang.</p>
    </div>
  </header>

  <section class="panel">
    <div class="panel-heading"><div><h2>Create clipping preset</h2><p>Gunakan preset untuk menyimpan strategi default. Isi brief editor dengan bahasa biasa, lalu buka JSON hanya jika memang perlu kontrol teknis tambahan.</p></div></div>
    <div class="p-4">
      <div class="form-message"></div>
      <form class="row g-3" data-api-form action="/api/v1/presets" method="post">
        <input type="hidden" name="_csrf" value="<%= csrfToken %>">
        <div class="col-md-4"><label class="form-label">Preset name</label><input class="form-control" name="name" placeholder="Short Edu Indonesia" required></div>
        <div class="col-md-3"><label class="form-label">Type</label><select class="form-select" name="type"><option value="CLIPPING">CLIPPING</option><option value="SUBTITLE">SUBTITLE</option><option value="BRAND">BRAND</option><option value="PUBLISHING">PUBLISHING</option><option value="TTS">TTS</option></select></div>
        <div class="col-md-3"><label class="form-label">Description</label><input class="form-control" name="description" placeholder="9:16, 30-45s, bold subtitle"></div>
        <div class="col-md-2 d-flex align-items-end"><div class="form-check"><input class="form-check-input" type="checkbox" name="is_default" id="preset_default"><label class="form-check-label" for="preset_default">Set as default</label></div></div>
        <div class="col-md-12"><label class="form-label">Editor brief</label><textarea class="form-control" rows="5" name="analysis_brief" placeholder="Arahan editor untuk AI: tipe hook, prioritas momen, pola ending, gaya bahasa, hal yang harus dihindari, dan konteks audience.">Anda adalah editor short video Indonesia untuk TikTok, Reels, dan YouTube Shorts. Pilih potongan yang paling cepat menarik perhatian, mudah dipahami tanpa konteks panjang, dan punya payoff yang selesai dengan rapi. Prioritaskan hook kuat di 1-3 detik pertama, konflik atau rasa penasaran yang jelas, insight praktis, bahasa natural, dan ending yang memicu komentar, share, atau save. Jangan pernah memotong saat pembicara masih setengah menjelaskan atau saat kalimat berikutnya jelas masih menyelesaikan poin utama. Untuk konten edukatif, lebih baik tambah beberapa detik agar jawaban benar-benar tuntas daripada hasil clip pendek tapi menggantung.</textarea><div class="form-text">Ini arahan utama yang akan dipakai AI saat memilih kandidat clip.</div></div>
        <div class="col-md-12"><details class="border rounded-4 p-3"><summary class="fw-semibold">Advanced config JSON</summary><p class="text-secondary small mt-2 mb-3">Buka ini hanya jika ingin mengatur field teknis preset secara manual. Untuk kebanyakan user, brief editor di atas sudah cukup.</p><label class="form-label">Config JSON</label><textarea class="form-control font-monospace" rows="10" name="config_json">{
  "target_platform": "YOUTUBE_SHORTS",
  "objective": "EDUCATION",
  "durations": { "min_seconds": 30, "max_seconds": 55 },
  "minimum_viral_score": 7.5,
  "hook_style": "QUESTION",
  "cta_preference": "COMMENT",
  "aspect_ratio": "9:16",
  "preferred_topics": ["hook 3 detik pertama", "audience retention", "CTA komentar"],
  "topics_to_avoid": ["politik partisan", "SARA", "klaim medis berisiko"],
  "subtitle": {
    "enabled": true,
    "language": "id",
    "style": "Bold Clean",
    "font_family": "Montserrat"
  }
}</textarea></details></div>
        <div class="col-md-12 d-flex justify-content-end"><button class="btn btn-primary" type="submit">Create preset</button></div>
      </form>
    </div>
  </section>

  <section class="panel mt-4">
    <div class="panel-heading"><div><h2>Create brand kit</h2><p>Brand kit stores typography, colors, safe margins, and subtitle preset defaults.</p></div></div>
    <div class="p-4">
      <div class="form-message"></div>
      <form class="row g-3" data-api-form action="/api/v1/brand-kits" method="post">
        <input type="hidden" name="_csrf" value="<%= csrfToken %>">
        <div class="col-md-4"><label class="form-label">Name</label><input class="form-control" name="name" placeholder="Studio default brand kit" required></div>
        <div class="col-md-2 d-flex align-items-end"><div class="form-check"><input class="form-check-input" type="checkbox" name="is_default" id="brand_default"><label class="form-check-label" for="brand_default">Default</label></div></div>
        <div class="col-md-6"><label class="form-label">Font config JSON</label><textarea class="form-control font-monospace" rows="6" name="font_config_json">{
  "primary": "Montserrat",
  "secondary": "Inter",
  "caption_weight": 700,
  "title_case": true
}</textarea></div>
        <div class="col-md-6"><label class="form-label">Color config JSON</label><textarea class="form-control font-monospace" rows="6" name="color_config_json">{
  "primary": "#111827",
  "accent": "#f59e0b",
  "subtitle_fill": "#ffffff",
  "subtitle_stroke": "#111827"
}</textarea></div>
        <div class="col-md-6"><label class="form-label">Safe margin JSON</label><textarea class="form-control font-monospace" rows="6" name="safe_margin_config_json">{
  "top_percent": 8,
  "bottom_percent": 10,
  "left_percent": 6,
  "right_percent": 6
}</textarea></div>
        <div class="col-md-6"><label class="form-label">Subtitle preset JSON</label><textarea class="form-control font-monospace" rows="6" name="subtitle_preset_json">{
  "position": "BOTTOM",
  "max_lines": 2,
  "word_highlight": true,
  "safe_margin_percent": 8
}</textarea></div>
        <div class="col-md-12 d-flex justify-content-end"><button class="btn btn-primary" type="submit">Create brand kit</button></div>
      </form>
    </div>
  </section>

  <section class="panel mt-4">
    <div class="panel-heading"><div><h2>Saved presets</h2><p>Edit preset yang sudah ada. Brief editor dipakai untuk strategi, sedangkan JSON hanya untuk opsi teknis tambahan.</p></div></div>
    <div class="p-4">
      <% if (!presets.length) { %><div class="empty-cell">No presets saved yet.</div><% } %>
      <% presets.forEach((preset) => { %>
        <form class="row g-3 border rounded-4 p-3 mb-3" data-api-form action="/api/v1/presets/<%= preset.id %>/update" method="post">
          <input type="hidden" name="_csrf" value="<%= csrfToken %>">
          <div class="col-md-4"><label class="form-label">Preset name</label><input class="form-control" name="name" value="<%= preset.name %>" required></div>
          <div class="col-md-3"><label class="form-label">Type</label><select class="form-select" name="type"><option value="CLIPPING" <%= preset.type === 'CLIPPING' ? 'selected' : '' %>>CLIPPING</option><option value="SUBTITLE" <%= preset.type === 'SUBTITLE' ? 'selected' : '' %>>SUBTITLE</option><option value="BRAND" <%= preset.type === 'BRAND' ? 'selected' : '' %>>BRAND</option><option value="PUBLISHING" <%= preset.type === 'PUBLISHING' ? 'selected' : '' %>>PUBLISHING</option><option value="TTS" <%= preset.type === 'TTS' ? 'selected' : '' %>>TTS</option></select></div>
          <div class="col-md-3"><label class="form-label">Description</label><input class="form-control" name="description" value="<%= preset.description ?? '' %>"></div>
          <div class="col-md-2 d-flex align-items-end"><div class="form-check"><input class="form-check-input" type="checkbox" name="is_default" id="preset_<%= preset.id %>" <%= preset.isDefault ? 'checked' : '' %>><label class="form-check-label" for="preset_<%= preset.id %>">Set as default</label></div></div>
          <% if (preset.type === 'CLIPPING') { %>
            <div class="col-md-12"><label class="form-label">Editor brief</label><textarea class="form-control" rows="5" name="analysis_brief" placeholder="Arahan editor untuk AI"><%= preset.analysisBrief %></textarea><div class="form-text">Dipakai sebagai arahan utama AI saat memilih clip.</div></div>
          <% } %>
          <div class="col-md-12"><details class="border rounded-4 p-3"><summary class="fw-semibold">Advanced config JSON</summary><label class="form-label mt-3">Config JSON</label><textarea class="form-control font-monospace" rows="6" name="config_json"><%= preset.configJson %></textarea></details></div>
          <div class="col-md-12 d-flex justify-content-between"><small>Updated <%= preset.updatedAt.toLocaleString() %></small><button class="btn btn-outline-primary" type="submit">Save preset</button></div>
        </form>
      <% }) %>
    </div>
  </section>

  <section class="panel mt-4">
    <div class="panel-heading"><div><h2>Saved brand kits</h2><p>Keep reusable visual identity defaults for subtitle and framing work.</p></div></div>
    <div class="p-4">
      <% if (!brandKits.length) { %><div class="empty-cell">No brand kits saved yet.</div><% } %>
      <% brandKits.forEach((brandKit) => { %>
        <form class="row g-3 border rounded-4 p-3 mb-3" data-api-form action="/api/v1/brand-kits/<%= brandKit.id %>/update" method="post">
          <input type="hidden" name="_csrf" value="<%= csrfToken %>">
          <div class="col-md-4"><label class="form-label">Name</label><input class="form-control" name="name" value="<%= brandKit.name %>" required></div>
          <div class="col-md-2 d-flex align-items-end"><div class="form-check"><input class="form-check-input" type="checkbox" name="is_default" id="brand_<%= brandKit.id %>" <%= brandKit.isDefault ? 'checked' : '' %>><label class="form-check-label" for="brand_<%= brandKit.id %>">Default</label></div></div>
          <div class="col-md-6"><label class="form-label">Font config JSON</label><textarea class="form-control font-monospace" rows="4" name="font_config_json"><%= brandKit.fontConfigJson %></textarea></div>
          <div class="col-md-6"><label class="form-label">Color config JSON</label><textarea class="form-control font-monospace" rows="4" name="color_config_json"><%= brandKit.colorConfigJson %></textarea></div>
          <div class="col-md-6"><label class="form-label">Safe margin JSON</label><textarea class="form-control font-monospace" rows="4" name="safe_margin_config_json"><%= brandKit.safeMarginConfigJson %></textarea></div>
          <div class="col-md-6"><label class="form-label">Subtitle preset JSON</label><textarea class="form-control font-monospace" rows="4" name="subtitle_preset_json"><%= brandKit.subtitlePresetJson %></textarea></div>
          <div class="col-md-12 d-flex justify-content-between"><small>Updated <%= brandKit.updatedAt.toLocaleString() %></small><button class="btn btn-outline-primary" type="submit">Save brand kit</button></div>
        </form>
      <% }) %>
    </div>
  </section>
</main></div>
<%- include('../partials/footer') %>
