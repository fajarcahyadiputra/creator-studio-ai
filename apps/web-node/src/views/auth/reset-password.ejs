<%- include('../partials/head', { title, csrfToken }) %>
<main class="auth-shell"><section class="auth-card">
  <h1 class="h3">Choose a new password</h1><div class="form-message"></div>
  <form data-api-form action="/api/v1/auth/reset-password" method="post" data-success-redirect>
    <input type="hidden" name="_csrf" value="<%= csrfToken %>">
    <input type="hidden" name="token" value="<%= token %>">
    <label class="form-label">New password</label><input class="form-control mb-3" type="password" name="password" minlength="12" required>
    <button class="btn btn-primary w-100" type="submit">Update password</button>
  </form>
</section></main>
<%- include('../partials/footer') %>
