NODE_ENV=development
APP_NAME=Creator Studio AI
APP_HOST=0.0.0.0
APP_PORT=3000
APP_BASE_URL=http://localhost:3000
TRUST_PROXY=false

DATABASE_URL=postgresql://creator:creator_dev_password@postgres:5432/creator_studio?schema=public
REDIS_URL=redis://redis:6379

SESSION_SECRET=replace-with-at-least-32-random-characters
COOKIE_SECURE=false
SESSION_TTL_SECONDS=604800

CSRF_SECRET=replace-with-at-least-32-random-characters
INTERNAL_SERVICE_TOKEN=replace-with-at-least-32-random-characters
CREDENTIAL_MASTER_KEY_BASE64=AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA=

S3_ENDPOINT=http://minio:9000
S3_PUBLIC_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin123
S3_BUCKET_MEDIA=creator-media
S3_FORCE_PATH_STYLE=true
SIGNED_URL_TTL_SECONDS=900
UPLOAD_MAX_SIZE_BYTES=10737418240
UPLOAD_PART_SIZE_BYTES=16777216

TEMPORAL_ADDRESS=temporal:7233
TEMPORAL_NAMESPACE=default
TEMPORAL_AUTO_CLIP_TASK_QUEUE=auto-clipping

SMTP_HOST=mailpit
SMTP_PORT=1025
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=Creator Studio AI <no-reply@creator-studio.local>

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:3000/api/v1/auth/google/callback

LOG_LEVEL=info
OTEL_EXPORTER_OTLP_ENDPOINT=http://otel-collector:4318

ADMIN_EMAIL=admin@example.local
ADMIN_PASSWORD=ChangeThisAdminPassword123!

INGESTION_PORT=3100
INGESTION_ALLOWED_HOSTS=youtube.com,www.youtube.com,youtu.be
INGESTION_MAX_DOWNLOAD_BYTES=10737418240
WEB_INTERNAL_BASE_URL=http://web-node:3000

PYTHON_API_PORT=8000
TEMP_WORKDIR=/tmp/creator-studio
