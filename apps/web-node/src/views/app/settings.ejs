<%- include('../partials/head', { title, csrfToken }) %>
<div class="workspace-shell"><%- include('../partials/user-topbar') %><main class="workspace-main content-area page-settings">
  <header class="page-header user-page-hero">
    <div class="user-page-hero__copy">
      <span class="eyebrow">Workspace settings</span>
      <h1>Settings</h1>
      <p>Kelola default profile creator, logo channel, notifikasi, dan keamanan akun dari satu halaman yang lebih terstruktur.</p>
    </div>
  </header>
  <section class="user-page-summary-grid user-page-summary-grid--compact">
    <article class="user-page-summary-card user-page-summary-card--soft"><span>Channel identity</span><strong>Name, tagline, logo</strong><p>Dipakai untuk template visual user seperti layout auto-clipping 9:16.</p></article>
    <article class="user-page-summary-card"><span>Workspace defaults</span><strong>Niche dan audience</strong><p>Membantu form baru terisi lebih cepat dengan konteks creator yang konsisten.</p></article>
    <article class="user-page-summary-card"><span>Account safety</span><strong>Password dan session</strong><p>Atur akses akun aktif dan revoke session yang sudah tidak dipakai.</p></article>
  </section>

  <section class="panel">
    <div class="panel-heading"><div><h2>Profile</h2><p>Name, locale, timezone, and creator defaults.</p></div></div>
    <div class="p-4">
      <div class="form-message"></div>
      <form class="row g-3" data-api-form action="/api/v1/settings/profile" method="post">
        <input type="hidden" name="_csrf" value="<%= csrfToken %>">
        <div class="col-md-4"><label class="form-label">Display name</label><input class="form-control" name="display_name" value="<%= profile.displayName %>" required></div>
        <div class="col-md-2"><label class="form-label">Locale</label><select class="form-select" name="locale"><option value="id" <%= profile.locale === 'id' ? 'selected' : '' %>>Indonesia</option><option value="en" <%= profile.locale === 'en' ? 'selected' : '' %>>English</option></select></div>
        <div class="col-md-3"><label class="form-label">Timezone</label><input class="form-control" name="timezone" value="<%= profile.timezone %>" required></div>
        <div class="col-md-3"><label class="form-label">Plan</label><input class="form-control" value="<%= user.plan?.name ?? 'No plan assigned' %>" readonly></div>
        <div class="col-md-6"><label class="form-label">Default content niche</label><input class="form-control" name="default_content_niche" value="<%= profile.defaultContentNiche %>"></div>
        <div class="col-md-6"><label class="form-label">Default audience</label><input class="form-control" name="default_audience" value="<%= profile.defaultAudience %>"></div>
        <div class="col-md-4"><label class="form-label">Channel name</label><input class="form-control" name="channel_name" value="<%= profile.channelName %>" placeholder="Suara Inspirasi"></div>
        <div class="col-md-4"><label class="form-label">Channel tagline</label><input class="form-control" name="channel_tagline" value="<%= profile.channelTagline %>" placeholder="Podcast Edukasi"></div>
        <div class="col-md-4">
          <label class="form-label">Preferred brand kit</label>
          <select class="form-select" name="preferred_brand_kit_id">
            <option value="">Use form selection</option>
            <% brandKits.forEach((brandKit) => { %>
              <option value="<%= brandKit.id %>" <%= profile.preferredBrandKitId === brandKit.id ? 'selected' : '' %>><%= brandKit.name %><%= brandKit.isDefault ? ' (default)' : '' %></option>
            <% }) %>
          </select>
        </div>
        <div class="col-md-8">
          <label class="form-label">Channel logo file</label>
          <input type="hidden" name="channel_logo_object_key" value="<%= profile.channelLogoObjectKey %>" data-settings-logo-object-key>
          <input
            class="form-control"
            type="file"
            accept="image/png,image/jpeg,image/webp,image/svg+xml"
            data-settings-logo-input>
          <div class="form-text">Upload logo PNG, JPG, WEBP, atau SVG. File akan disimpan ke MinIO dan dipakai untuk layout auto-clipping 9:16.</div>
          <div class="small text-muted mt-2" data-settings-logo-status>
            <%= profile.channelLogoObjectKey ? 'Logo channel sudah tersimpan. Pilih file baru jika ingin mengganti.' : 'Belum ada file logo diupload.' %>
          </div>
        </div>
        <div class="col-md-4">
          <label class="form-label">Logo preview</label>
          <div class="border rounded-4 bg-light d-flex align-items-center justify-content-center p-3 h-100" data-settings-logo-preview-wrap>
            <% if (profile.channelLogoUrl) { %>
              <img
                data-settings-logo-preview
                src="<%= profile.channelLogoUrl %>"
                alt="Channel logo preview"
                style="max-width: 100%; max-height: 120px; object-fit: contain;">
            <% } else { %>
              <small class="text-muted text-center" data-settings-logo-empty>Belum ada logo file tersimpan.<br>Upload logo channel agar template 9:16 bisa memakainya.</small>
            <% } %>
          </div>
        </div>
        <div class="col-md-12 d-flex justify-content-end"><button class="btn btn-primary" type="submit">Save profile</button></div>
      </form>
    </div>
  </section>

  <section class="panel mt-4">
    <div class="panel-heading"><div><h2>Notification Preferences</h2><p>Simple email and in-app defaults for job completion, failures, and quota signals.</p></div></div>
    <div class="p-4">
      <div class="form-message"></div>
      <form class="row g-3" data-api-form action="/api/v1/settings/notifications" method="post">
        <input type="hidden" name="_csrf" value="<%= csrfToken %>">
        <div class="col-md-4 form-check"><input class="form-check-input" type="checkbox" name="email_job_completed" id="email_job_completed" <%= notifications.email_job_completed ? 'checked' : '' %>><label class="form-check-label" for="email_job_completed">Email on job completed</label></div>
        <div class="col-md-4 form-check"><input class="form-check-input" type="checkbox" name="email_job_failed" id="email_job_failed" <%= notifications.email_job_failed ? 'checked' : '' %>><label class="form-check-label" for="email_job_failed">Email on job failed</label></div>
        <div class="col-md-4 form-check"><input class="form-check-input" type="checkbox" name="email_quota_warning" id="email_quota_warning" <%= notifications.email_quota_warning ? 'checked' : '' %>><label class="form-check-label" for="email_quota_warning">Email on quota warning</label></div>
        <div class="col-md-4 form-check"><input class="form-check-input" type="checkbox" name="in_app_job_completed" id="in_app_job_completed" <%= notifications.in_app_job_completed ? 'checked' : '' %>><label class="form-check-label" for="in_app_job_completed">In-app on job completed</label></div>
        <div class="col-md-4 form-check"><input class="form-check-input" type="checkbox" name="in_app_job_failed" id="in_app_job_failed" <%= notifications.in_app_job_failed ? 'checked' : '' %>><label class="form-check-label" for="in_app_job_failed">In-app on job failed</label></div>
        <div class="col-md-4 form-check"><input class="form-check-input" type="checkbox" name="in_app_publish_completed" id="in_app_publish_completed" <%= notifications.in_app_publish_completed ? 'checked' : '' %>><label class="form-check-label" for="in_app_publish_completed">In-app on publish completed</label></div>
        <div class="col-md-12 d-flex justify-content-end"><button class="btn btn-primary" type="submit">Save notifications</button></div>
      </form>
    </div>
  </section>

  <section class="panel mt-4">
    <div class="panel-heading"><div><h2>Security</h2><p>Change password and revoke active sessions.</p></div></div>
    <div class="p-4">
      <div class="form-message"></div>
      <form class="row g-3" data-api-form action="/api/v1/settings/password" method="post">
        <input type="hidden" name="_csrf" value="<%= csrfToken %>">
        <div class="col-md-4"><label class="form-label">Current password</label><input class="form-control" type="password" name="current_password" required></div>
        <div class="col-md-4"><label class="form-label">New password</label><input class="form-control" type="password" name="new_password" minlength="12" required></div>
        <div class="col-md-4 d-flex align-items-end"><button class="btn btn-primary w-100" type="submit">Change password</button></div>
      </form>

      <div class="table-responsive mt-4">
        <table class="table align-middle">
          <thead><tr><th>Session</th><th>Network</th><th>Timing</th><th>Action</th></tr></thead>
          <tbody>
            <% if (!sessions.length) { %><tr><td colspan="4" class="empty-cell">No active sessions found.</td></tr><% } %>
            <% sessions.forEach((session) => { %>
              <tr>
                <td><strong><%= session.isCurrent ? 'Current session' : 'Active session' %></strong><br><small><%= session.userAgent ?? 'Unknown device' %></small></td>
                <td><%= session.ipAddress ?? 'Unknown IP' %><br><small><%= session.impersonatedUserId ? `Impersonating ${session.impersonatedUserId}` : 'Standard access' %></small></td>
                <td><%= session.createdAt.toLocaleString() %><br><small>Expires <%= session.expiresAt.toLocaleString() %></small></td>
                <td><% if (!session.isCurrent) { %><form data-api-form action="/api/v1/settings/sessions/<%= session.id %>/revoke" method="post"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><button class="btn btn-sm btn-outline-danger" type="submit">Revoke</button></form><% } else { %><span class="text-muted">Current session</span><% } %></td>
              </tr>
            <% }) %>
          </tbody>
        </table>
      </div>
    </div>
  </section>
</main></div>
<%- include('../partials/footer') %>
