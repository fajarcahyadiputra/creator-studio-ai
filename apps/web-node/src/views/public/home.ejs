<%- include('../partials/head', { title, csrfToken, pageLang, metaDescription, metaKeywords, canonicalUrl, ogTitle, ogDescription, twitterTitle, twitterDescription }) %>
<main class="marketing-shell">
  <section class="marketing-hero">
    <div class="marketing-nav">
      <a class="marketing-brand" href="/?lang=<%= selectedLanguage %>">
        <span class="marketing-brand__mark"><%- include('../partials/brand-mark', { markClass: 'brand-mark-svg' }) %></span>
        <span><%= appName %></span>
      </a>

      <nav class="marketing-nav__links" aria-label="<%= selectedLanguage === 'id' ? 'Navigasi halaman' : 'Page navigation' %>">
        <a href="#tools"><%= selectedLanguage === 'id' ? 'Tools AI' : 'AI tools' %></a>
        <a href="#hasil"><%= selectedLanguage === 'id' ? 'Contoh hasil' : 'Examples' %></a>
        <a href="#cara-kerja"><%= selectedLanguage === 'id' ? 'Cara kerja' : 'How it works' %></a>
        <a href="#faq">FAQ</a>
      </nav>

      <div class="marketing-nav__cluster">
        <div class="marketing-language-switch" aria-label="<%= home.languageLabel %>">
          <a
            class="marketing-language-switch__link <%= selectedLanguage === 'id' ? 'is-active' : '' %>"
            href="/?lang=id"
          >ID</a>
          <a
            class="marketing-language-switch__link <%= selectedLanguage === 'en' ? 'is-active' : '' %>"
            href="/?lang=en"
          >EN</a>
        </div>

        <div class="marketing-nav__actions">
          <a class="btn btn-outline-dark" href="/login"><%= home.navLogin %></a>
          <a class="btn btn-warning" href="/register"><%= home.navRegister %></a>
        </div>
      </div>
    </div>

    <div class="marketing-hero__content">
      <div class="marketing-hero__copy">
        <span class="eyebrow"><%= home.heroEyebrow %></span>
        <h1><%= home.heroTitle %></h1>
        <p><%= home.heroDescription %></p>

        <div class="marketing-hero__cta">
          <a class="btn btn-warning btn-lg" href="/register"><%= home.heroPrimaryCta %></a>
          <a class="btn btn-outline-dark btn-lg" href="/login"><%= home.heroSecondaryCta %></a>
        </div>

        <p class="marketing-hero__proof"><span aria-hidden="true">&#10003;</span> <%= home.heroProof %></p>

        <div class="marketing-proofbar" aria-label="Workflow">
          <% home.previewSteps.forEach((step, index) => { %>
            <span><b><%= String(index + 1).padStart(2, '0') %></b><%= step %></span>
          <% }) %>
        </div>
      </div>

      <div class="marketing-hero__preview">
        <div class="marketing-studio-demo">
          <div class="marketing-studio-demo__topbar">
            <span class="marketing-studio-demo__status"><i></i><%= selectedLanguage === 'id' ? 'Output siap direview' : 'Output ready to review' %></span>
            <span>creator-studio / auto-clip</span>
          </div>
          <div class="marketing-studio-demo__canvas">
            <div class="marketing-studio-phone" aria-label="<%= home.previewLabel %>">
              <div class="marketing-studio-phone__brand"><span>CS</span><small>Creator Studio AI</small></div>
              <div class="marketing-studio-phone__headline">
                <strong><%= selectedLanguage === 'id' ? 'SATU JAWABAN' : 'ONE ANSWER' %></strong>
                <em><%= selectedLanguage === 'id' ? 'UBAH SEMUANYA' : 'CHANGES EVERYTHING' %></em>
              </div>
              <div class="marketing-studio-phone__scene">
                <span class="marketing-studio-phone__person marketing-studio-phone__person--one"></span>
                <span class="marketing-studio-phone__person marketing-studio-phone__person--two"></span>
                <span class="marketing-studio-phone__mic"></span>
              </div>
              <div class="marketing-studio-phone__subtitle">
                <span><%= selectedLanguage === 'id' ? 'yang orang cari bukan video panjang,' : 'people do not need another long video,' %></span>
                <strong><%= selectedLanguage === 'id' ? 'tapi momen yang tepat.' : 'they need the right moment.' %></strong>
              </div>
              <div class="marketing-studio-phone__timeline"><i></i></div>
            </div>

            <div class="marketing-studio-demo__insights">
              <div class="marketing-studio-demo__label"><%= home.previewLabel %></div>
              <h2><%= home.previewTitle %></h2>
              <div class="marketing-studio-score">
                <div><span>Viral score</span><strong>9.1<small>/10</small></strong></div>
                <div class="marketing-studio-score__bars"><i></i><i></i><i></i><i></i><i></i></div>
              </div>
              <ul class="marketing-studio-checks">
                <li><span>&#10003;</span><%= selectedLanguage === 'id' ? 'Hook terdeteksi' : 'Hook detected' %></li>
                <li><span>&#10003;</span><%= selectedLanguage === 'id' ? 'Ending tetap utuh' : 'Complete ending' %></li>
                <li><span>&#10003;</span><%= selectedLanguage === 'id' ? 'Subtitle siap render' : 'Subtitles ready' %></li>
              </ul>
              <div class="marketing-studio-export"><span>9:16</span><span>SRT</span><span>MP4</span></div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <section class="marketing-section marketing-section--trust">
    <div class="marketing-trust-panel">
      <div class="marketing-trust-panel__copy">
        <span class="eyebrow">Creator Studio AI</span>
        <h2><%= home.trustTitle %></h2>
      </div>
      <div class="marketing-trust-list">
        <% home.trustItems.forEach((item) => { %>
          <span><%= item %></span>
        <% }) %>
      </div>
    </div>
  </section>

  <section class="marketing-section">
    <div class="marketing-section__header">
      <span class="eyebrow"><%= home.whyEyebrow %></span>
      <h2><%= home.whyTitle %></h2>
    </div>
    <div class="marketing-grid">
      <% home.whyCards.forEach((card) => { %>
        <article class="marketing-card">
          <h3><%= card.title %></h3>
          <p><%= card.description %></p>
        </article>
      <% }) %>
    </div>
  </section>

  <section id="cara-kerja" class="marketing-section marketing-section--compact">
    <div class="marketing-section__header">
      <span class="eyebrow"><%= home.workflowEyebrow %></span>
      <h2><%= home.workflowTitle %></h2>
    </div>
    <div class="marketing-feature-list">
      <% home.workflowSteps.forEach((step) => { %>
        <article class="marketing-feature marketing-feature--step">
          <span class="marketing-feature__step-index"><%= step.index %></span>
          <strong><%= step.title %></strong>
          <p><%= step.description %></p>
        </article>
      <% }) %>
    </div>
  </section>

  <section id="tools" class="marketing-section marketing-section--tools">
    <div class="marketing-section__header marketing-section__header--split">
      <div>
        <span class="eyebrow"><%= home.toolsEyebrow %></span>
        <h2><%= home.toolsTitle %></h2>
      </div>
      <p><%= home.toolsDescription %></p>
    </div>
    <div class="marketing-tools-grid">
      <% home.tools.forEach((tool, index) => { %>
        <article class="marketing-tool-card <%= index === 0 ? 'marketing-tool-card--primary' : 'marketing-tool-card--secondary' %>">
          <div class="marketing-tool-card__icon" aria-hidden="true"><%= index === 0 ? '01' : '02' %></div>
          <span class="marketing-tool-card__eyebrow"><%= tool.eyebrow %></span>
          <h3><%= tool.title %></h3>
          <p><%= tool.description %></p>
          <ul class="marketing-tool-card__list">
            <% tool.bullets.forEach((bullet) => { %>
              <li><%= bullet %></li>
            <% }) %>
          </ul>
          <div class="marketing-tool-card__footer">
            <a class="btn <%= index === 0 ? 'btn-warning' : 'btn-outline-dark' %>" href="<%= index === 0 ? '/app/tools/auto-clipping' : '/app/tools/text-to-speech' %>"><%= tool.cta %></a>
          </div>
        </article>
      <% }) %>
    </div>
  </section>

  <section id="hasil" class="marketing-section marketing-section--showcase">
    <div class="marketing-section__header marketing-section__header--centered">
      <span class="eyebrow"><%= home.showcaseEyebrow %></span>
      <h2><%= home.showcaseTitle %></h2>
      <p><%= home.showcaseDescription %></p>
    </div>
    <div class="marketing-showcase-track">
      <% home.showcaseSlides.forEach((slide, index) => { %>
        <article class="marketing-showcase-card">
          <div class="marketing-showcase-card__frame">
            <div class="marketing-showcase-card__badge"><%= slide.badge %></div>
            <div class="marketing-showcase-card__video">
              <div class="marketing-showcase-card__speaker" aria-hidden="true">
                <span class="marketing-showcase-card__speaker-head"></span>
                <span class="marketing-showcase-card__speaker-body"></span>
                <span class="marketing-showcase-card__speaker-mic"></span>
              </div>
              <div class="marketing-showcase-card__play">▶</div>
              <div class="marketing-showcase-card__subtitle">
                <span><%= index === 0 ? 'MENGHILANGKAN ADAB' : index === 1 ? 'INI KAKINYA DIPEGANGIN' : 'LOH, LU BAYANGIN, GUYS.' %></span>
              </div>
              <div class="marketing-showcase-card__footerbar">
                <span>Putar & lihat detail</span>
              </div>
            </div>
          </div>
          <div class="marketing-showcase-card__meta">
            <strong><%= slide.title %></strong>
            <p><%= slide.subtitle %></p>
          </div>
        </article>
      <% }) %>
    </div>
  </section>

  <section class="marketing-section marketing-section--alt">
    <div class="marketing-section__header">
      <span class="eyebrow"><%= home.useCasesEyebrow %></span>
      <h2><%= home.useCasesTitle %></h2>
    </div>
    <div class="marketing-grid marketing-grid--wide">
      <% home.useCases.forEach((card) => { %>
        <article class="marketing-card">
          <h3><%= card.title %></h3>
          <p><%= card.description %></p>
        </article>
      <% }) %>
    </div>
  </section>

  <section id="faq" class="marketing-section marketing-section--faq">
    <div class="marketing-faq-shell">
      <div class="marketing-faq-copy">
        <span class="eyebrow"><%= home.faqEyebrow %></span>
        <h2><%= home.faqTitle %></h2>
        <p><%= home.faqDescription %></p>
      </div>
      <div class="marketing-faq-list">
        <% home.faqs.forEach((item, index) => { %>
          <details class="marketing-faq-item" <%= index === 0 ? 'open' : '' %>>
            <summary>
              <span><%= item.question %></span>
              <span class="marketing-faq-item__icon">+</span>
            </summary>
            <div class="marketing-faq-item__body">
              <p><%= item.answer %></p>
            </div>
          </details>
        <% }) %>
      </div>
    </div>
  </section>

  <section class="marketing-section marketing-section--cta">
    <div class="marketing-cta-panel">
      <div>
        <span class="eyebrow"><%= home.ctaEyebrow %></span>
        <h2><%= home.ctaTitle %></h2>
        <p><%= home.ctaDescription %></p>
      </div>
      <div class="marketing-cta-panel__actions">
        <a class="btn btn-warning btn-lg" href="/register"><%= home.ctaPrimary %></a>
        <a class="btn btn-outline-light btn-lg" href="/login"><%= home.ctaSecondary %></a>
      </div>
    </div>
  </section>
</main>
<%- include('../partials/footer') %>
