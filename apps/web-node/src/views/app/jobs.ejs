<%- include('../partials/head', { title, csrfToken }) %>
<div class="workspace-shell"><%- include('../partials/user-topbar') %><main class="workspace-main content-area">
  <header class="page-header"><div><span class="eyebrow">Hasil Clipping</span><h1>Jobs & Results</h1><p>Pantau progress, review hasil clipping, dan lanjutkan workflow creator tanpa kehilangan status.</p></div><a class="btn btn-primary" href="/app/tools/auto-clipping">New Auto Clip</a></header>
  <section class="panel">
    <div class="panel-heading"><div><h2>Filters</h2><p>Filter by tool, status, date, search term, or provider.</p></div></div>
    <div class="p-4">
      <form class="row g-3" method="get" action="/app/jobs">
        <div class="col-md-4"><label class="form-label">Search</label><input class="form-control" name="search" value="<%= filters.search %>" placeholder="job id, project, source"></div>
        <div class="col-md-2"><label class="form-label">Type</label><select class="form-select" name="type"><option value="ALL" <%= filters.type === 'ALL' ? 'selected' : '' %>>All</option><% typeOptions.forEach((type) => { %><option value="<%= type %>" <%= filters.type === type ? 'selected' : '' %>><%= type %></option><% }) %></select></div>
        <div class="col-md-2"><label class="form-label">Status</label><select class="form-select" name="status"><option value="ALL" <%= filters.status === 'ALL' ? 'selected' : '' %>>All</option><% statusOptions.forEach((status) => { %><option value="<%= status %>" <%= filters.status === status ? 'selected' : '' %>><%= status %></option><% }) %></select></div>
        <div class="col-md-2"><label class="form-label">Provider</label><select class="form-select" name="provider"><option value="" <%= !filters.provider ? 'selected' : '' %>>Any</option><% providerOptions.forEach((provider) => { %><option value="<%= provider %>" <%= filters.provider === provider ? 'selected' : '' %>><%= provider %></option><% }) %></select></div>
        <div class="col-md-1"><label class="form-label">From</label><input class="form-control" type="date" name="date_from" value="<%= filters.dateFrom %>"></div>
        <div class="col-md-1"><label class="form-label">To</label><input class="form-control" type="date" name="date_to" value="<%= filters.dateTo %>"></div>
        <div class="col-md-12 d-flex gap-2"><button class="btn btn-primary" type="submit">Apply filters</button><a class="btn btn-outline-secondary" href="/app/jobs">Reset</a></div>
      </form>
    </div>
  </section>
  <section class="panel mt-4"><div class="table-responsive"><table class="table align-middle jobs-table"><thead><tr><th>ID</th><th>Project / Source</th><th>Type</th><th>Status</th><th>Current stage</th><th>Progress</th><th>Provider</th><th>Created / Running</th><th>Actions</th></tr></thead><tbody>
    <% if (!jobs.length) { %><tr><td colspan="9" class="empty-cell">No jobs found.</td></tr><% } %>
    <% jobs.forEach(job => { %><tr data-job-id="<%= job.id %>" data-job-stream-row="<%= job.id %>"><td><a href="/app/jobs/<%= job.id %>"><code><%= job.shortId %></code></a></td><td><strong><%= job.projectName ?? 'No project' %></strong><br><small><%= job.sourceName ?? 'No source linked' %></small></td><td><%= job.type %></td><td><span class="status status-<%= job.status.toLowerCase() %>" data-job-row-status><%= job.status %></span></td><td data-job-row-stage><%= job.currentStage ?? '-' %></td><td><div class="progress"><div class="progress-bar" data-job-row-progress-bar style="width:<%= job.progressPercent %>%"></div></div><small data-job-row-progress-value><%= job.progressPercent %>%</small></td><td><%= job.provider ?? '-' %></td><td><%= job.createdAt.toLocaleString() %><br><small><%= job.runningDurationLabel ?? 'No ETA shown' %></small></td><td><div class="d-flex flex-wrap gap-2"><a class="btn btn-sm btn-outline-primary" href="/app/jobs/<%= job.id %>">View</a><% if (['QUEUED','RUNNING','PAUSED','PAUSE_REQUESTED'].includes(job.status)) { %><form data-api-form action="/api/v1/jobs/<%= job.id %>/cancel" method="post"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><button class="btn btn-sm btn-outline-danger" type="submit">Cancel</button></form><% } %><% if (job.status === 'FAILED') { %><form data-api-form data-idempotency-key="true" action="/api/v1/jobs/<%= job.id %>/retry" method="post"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><input type="hidden" name="reason" value="Retry requested from jobs list"><button class="btn btn-sm btn-outline-warning" type="submit">Retry</button></form><% } %><% if (job.type === 'AUTO_CLIPPING') { %><form data-api-form data-idempotency-key="true" action="/api/v1/auto-clipping/jobs/<%= job.id %>/duplicate" method="post"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><button class="btn btn-sm btn-outline-secondary" type="submit">Duplicate</button></form><% } %></div></td></tr><% }) %>
  </tbody></table></div></section>
</main></div>
<%- include('../partials/footer') %>
