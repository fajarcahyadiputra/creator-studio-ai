{
  "name": "@creator-studio/web-node",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "dist/server.js",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "dev:email-worker": "tsx watch src/workers/email-worker.ts",
    "build": "npm run prisma:generate && tsc -p tsconfig.json && node scripts/copy-static.mjs",
    "start": "node dist/server.js",
    "start:email-worker": "node dist/workers/email-worker.js",
    "typecheck": "npm run prisma:generate && tsc -p tsconfig.json --noEmit",
    "test": "npm run prisma:generate && vitest run",
    "lint": "npm run typecheck",
    "format": "prettier --write src prisma *.ts *.json",
    "prisma:generate": "prisma generate && node scripts/ensure-prisma-dev-client.mjs",
    "prisma:migrate": "prisma migrate dev",
    "prisma:migrate:deploy": "prisma migrate deploy",
    "prisma:seed": "prisma db seed"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1075.0",
    "@aws-sdk/s3-request-presigner": "^3.1075.0",
    "@creator-studio/contracts": "0.1.0",
    "@prisma/adapter-pg": "^7.8.0",
    "@prisma/client": "^7.8.0",
    "@temporalio/client": "^1.16.2",
    "argon2": "^0.44.0",
    "bullmq": "^5.79.1",
    "connect-redis": "^9.0.0",
    "dotenv": "^17.2.3",
    "ejs": "^3.1.10",
    "express": "^5.2.1",
    "express-rate-limit": "^8.5.2",
    "express-session": "^1.19.0",
    "helmet": "^8.2.0",
    "ioredis": "^5.11.1",
    "nodemailer": "^9.0.1",
    "passport": "^0.7.0",
    "passport-google-oauth20": "^2.0.0",
    "pg": "^8.22.0",
    "pino": "^10.3.1",
    "pino-http": "^11.0.0",
    "prom-client": "^15.1.3",
    "redis": "^5.10.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/ejs": "^3.1.5",
    "@types/express": "^5.0.6",
    "@types/express-session": "^1.18.2",
    "@types/node": "^24.10.0",
    "@types/nodemailer": "^7.0.5",
    "@types/passport": "^1.0.17",
    "@types/passport-google-oauth20": "^2.0.16",
    "@types/pg": "^8.15.6",
    "@types/supertest": "^6.0.3",
    "prettier": "^3.8.5",
    "prisma": "^7.8.0",
    "supertest": "^7.2.2",
    "tsx": "^4.22.4",
    "typescript": "^6.0.3",
    "vitest": "^4.1.9"
  },
  "engines": {
    "node": ">=24.0.0"
  }
}
