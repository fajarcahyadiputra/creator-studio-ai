# Copy this file to .env.deploy and edit only deployment values here.
# deploy.sh will not read or modify the development .env file.

DEPLOY_PROJECT_NAME=creator-studio-ai-deploy
DEPLOY_COMPOSE_PROFILES=
DEPLOY_BUILD=true
DEPLOY_PULL=false
DEPLOY_WAIT_SECONDS=180

NODE_ENV=production
APP_NAME=Creator Studio AI
APP_HOST=0.0.0.0
APP_PORT=3000
APP_BASE_URL=https://creator.example.com
TRUST_PROXY=true

WEB_BIND_HOST=0.0.0.0
WEB_PORT=3000

POSTGRES_USER=creator
POSTGRES_PASSWORD=change-this-postgres-password
POSTGRES_DB=creator_studio
POSTGRES_BIND_HOST=127.0.0.1
POSTGRES_PORT=5432
DATABASE_URL=postgresql://creator:change-this-postgres-password@postgres:5432/creator_studio?schema=public

REDIS_BIND_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_URL=redis://redis:6379

MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=change-this-minio-password
MINIO_BIND_HOST=0.0.0.0
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001
MINIO_USERS_EXPIRE_DAYS=2
S3_ENDPOINT=http://minio:9000
S3_PUBLIC_ENDPOINT=https://media.creator.example.com
S3_REGION=us-east-1
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=change-this-minio-password
S3_BUCKET_MEDIA=creator-media
S3_FORCE_PATH_STYLE=true
SIGNED_URL_TTL_SECONDS=900
UPLOAD_MAX_SIZE_BYTES=10737418240
UPLOAD_PART_SIZE_BYTES=16777216
HTTP_JSON_BODY_LIMIT_MB=8

TEMPORAL_BIND_HOST=127.0.0.1
TEMPORAL_PORT=7233
TEMPORAL_UI_BIND_HOST=127.0.0.1
TEMPORAL_UI_PORT=8080
TEMPORAL_CORS_ORIGINS=https://creator.example.com
TEMPORAL_ADDRESS=temporal:7233
TEMPORAL_NAMESPACE=default
TEMPORAL_AUTO_CLIP_TASK_QUEUE=auto-clipping
TEMPORAL_MAX_CONCURRENT_ACTIVITIES=4

MEDIA_INGESTION_INTERNAL_BASE_URL=http://media-ingestion-node:3100
AI_MEDIA_PYTHON_INTERNAL_BASE_URL=http://ai-media-python-api:8000
WEB_INTERNAL_BASE_URL=http://web-node:3000
INGESTION_PORT=3100
INGESTION_ALLOWED_HOSTS=youtube.com,www.youtube.com,youtu.be
INGESTION_MAX_DOWNLOAD_BYTES=10737418240

PYTHON_API_PORT=8000
TEMP_WORKDIR=/tmp/creator-studio
CALLBACK_TIMEOUT_SECONDS=10
MEDIA_PROBE_TIMEOUT_SECONDS=30
EXTERNAL_SOURCE_MATERIALIZATION_TIMEOUT_SECONDS=7200
YT_DLP_COOKIES_FILE=/run/secrets/yt-dlp/cookies.txt
AUDIO_EXTRACTION_TIMEOUT_SECONDS=120
TRANSCRIPTION_TIMEOUT_SECONDS=5400
ANALYZER_TIMEOUT_SECONDS=180

SESSION_SECRET=replace-with-at-least-32-random-characters
COOKIE_SECURE=true
SESSION_TTL_SECONDS=604800
CSRF_SECRET=replace-with-at-least-32-random-characters
INTERNAL_SERVICE_TOKEN=replace-with-at-least-32-random-characters
CREDENTIAL_MASTER_KEY_BASE64=AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA=

SMTP_HOST=mailpit
SMTP_PORT=1025
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=Creator Studio AI <no-reply@creator.example.com>

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=https://creator.example.com/api/v1/auth/google/callback

LOG_LEVEL=info
OTEL_EXPORTER_OTLP_ENDPOINT=http://otel-collector:4318

ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=ChangeThisAdminPassword123!

TTS_MODEL_DIR=/models/tts
FASTER_WHISPER_MODEL_SIZE=small
FASTER_WHISPER_DEVICE=cpu
FASTER_WHISPER_COMPUTE_TYPE=int8
FACE_DETECTION_YUNET_MODEL_PATH=/models/face/face_detection_yunet_2023mar.onnx
FACE_DETECTION_YUNET_SCORE_THRESHOLD=0.72
AUTO_CLIP_ANALYZER_MODE=openai_then_heuristic
AUTO_CLIP_ANALYZER_PROVIDER=openai
AUTO_CLIP_ANALYZER_MODEL=gpt-5.5
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_TIMEOUT_SECONDS=90
PIPER_COMMAND=piper
TTS_SAMPLE_TEXT=Halo, ini adalah sample suara untuk preview model TTS.

MAILPIT_SMTP_BIND_HOST=127.0.0.1
MAILPIT_SMTP_PORT=1025
MAILPIT_UI_BIND_HOST=127.0.0.1
MAILPIT_UI_PORT=8025

PROMETHEUS_BIND_HOST=127.0.0.1
PROMETHEUS_PORT=9090
GRAFANA_BIND_HOST=127.0.0.1
GRAFANA_PORT=3001
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=change-this-grafana-password
