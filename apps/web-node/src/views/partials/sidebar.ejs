<aside class="sidebar">
  <a class="brand" href="/app/dashboard"><span class="brand-mark">C</span><span><%= appName %></span></a>
  <nav class="nav flex-column gap-1 mt-4">
    <a class="nav-link <%= path === '/app/dashboard' ? 'active' : '' %>" href="/app/dashboard">Dashboard</a>
    <a class="nav-link <%= path.includes('/app/tools') ? 'active' : '' %>" href="/app/tools/auto-clipping">Auto Clipping</a>
    <a class="nav-link <%= path.startsWith('/app/jobs') ? 'active' : '' %>" href="/app/jobs">Jobs</a>
    <a class="nav-link <%= path.startsWith('/app/media') ? 'active' : '' %>" href="/app/media">Media Library</a>
    <a class="nav-link <%= path.startsWith('/app/presets') ? 'active' : '' %>" href="/app/presets">Templates & Presets</a>
    <span class="nav-link disabled">Text to Speech - Phase 4</span>
    <span class="nav-link disabled">Transcription - Phase 4</span>
    <a class="nav-link <%= path.startsWith('/app/settings') ? 'active' : '' %>" href="/app/settings">Settings</a>
    <% if (identity?.permissions?.has('admin.dashboard.view')) { %>
      <a class="nav-link mt-3" href="/admin/dashboard">Administration</a>
      <% if (identity?.permissions?.has('admin.users.read')) { %>
        <a class="nav-link <%= path.startsWith('/admin/users') ? 'active' : '' %>" href="/admin/users">Admin Users</a>
      <% } %>
      <% if (identity?.permissions?.has('admin.providers.manage')) { %>
        <a class="nav-link <%= path.startsWith('/admin/providers') ? 'active' : '' %>" href="/admin/providers">Providers & Models</a>
      <% } %>
      <% if (identity?.permissions?.has('admin.jobs.manage')) { %>
        <a class="nav-link <%= path.startsWith('/admin/jobs') ? 'active' : '' %>" href="/admin/jobs">Admin Jobs</a>
      <% } %>
      <% if (identity?.permissions?.has('admin.system.manage')) { %>
        <a class="nav-link <%= path.startsWith('/admin/system') ? 'active' : '' %>" href="/admin/system">System Controls</a>
      <% } %>
      <% if (identity?.permissions?.has('admin.audit.read')) { %>
        <a class="nav-link <%= path.startsWith('/admin/audit-logs') ? 'active' : '' %>" href="/admin/audit-logs">Audit Logs</a>
      <% } %>
      <% if (identity?.permissions?.has('admin.dashboard.view')) { %>
        <a class="nav-link <%= path.startsWith('/admin/workers') ? 'active' : '' %>" href="/admin/workers">Worker Health</a>
      <% } %>
    <% } %>
  </nav>
  <div class="sidebar-footer">
    <% if (impersonation) { %>
      <div class="alert alert-warning small py-2">Viewing user workspace with an audited context.</div>
      <button class="btn btn-sm btn-outline-warning w-100" data-api-action="/api/v1/admin/impersonation/stop">Stop view-as-user</button>
    <% } %>
    <button class="btn btn-sm btn-outline-light w-100 mt-2" data-api-action="/api/v1/auth/logout">Logout</button>
  </div>
</aside>
