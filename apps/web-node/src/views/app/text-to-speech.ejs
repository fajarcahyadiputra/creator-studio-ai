<%- include('../partials/head', { title, csrfToken }) %>
<div class="workspace-shell"><%- include('../partials/user-topbar') %><main class="workspace-main content-area page-text-to-speech">
  <header class="page-header user-page-hero">
    <div class="user-page-hero__copy">
      <span class="eyebrow">Tools</span>
      <h1>Text to Speech</h1>
      <p>Susun segment narasi yang natural, preview suara lokal, lalu render audio final yang siap direview langsung dari job detail.</p>
    </div>
  </header>
  <section class="user-page-summary-grid user-page-summary-grid--compact">
    <article class="user-page-summary-card user-page-summary-card--soft"><span>Segmentasi script</span><strong>Natural by default</strong><p>Script dipecah jadi bagian yang lebih enak didengar tanpa mengubah wording utama.</p></article>
    <article class="user-page-summary-card"><span>Preview lokal</span><strong>Piper model test</strong><p>Coba model suara dulu sebelum submit job penuh supaya output final lebih terarah.</p></article>
    <article class="user-page-summary-card"><span>Target duration</span><strong>Auto dari speed</strong><p>Estimasi durasi dihitung dari script dan speaking speed agar form tetap lebih akurat.</p></article>
  </section>
  <div class="alert alert-info user-inline-banner">Workflow ini membuat segment plan TTS, merender audio narration lokal, lalu menyimpan hasil audio ke job detail untuk review dan download.</div>
  <div class="form-message"></div>

  <form id="tts-form" class="wizard-panel">
    <input type="hidden" name="_csrf" value="<%= csrfToken %>">
    <script type="application/json" id="tts-presets-json"><%- JSON.stringify(ttsPresets) %></script>
    <script type="application/json" id="tts-local-models-json"><%- JSON.stringify(localTtsModels) %></script>

    <section class="wizard-step">
      <div class="step-number">1</div>
      <div class="step-body">
        <h2>Preset, engine, dan voice direction</h2>
        <p class="user-step-lead">Mulai dari preset dan model lokal, lalu atur karakter suara utama sebelum menulis script narasi.</p>
        <div class="row g-3">
          <div class="col-md-6">
            <label class="form-label">TTS preset</label>
            <select class="form-select" name="tts_preset_id" data-tts-preset-selector>
              <option value="">Manual defaults</option>
              <% ttsPresets.forEach((preset) => { %>
                <option value="<%= preset.id %>" <%= selectedPresetId === preset.id ? 'selected' : '' %>><%= preset.name %><%= preset.isDefault ? ' (default)' : '' %></option>
              <% }) %>
            </select>
          </div>
          <div class="col-md-6">
            <label class="form-label">Local Piper model</label>
            <select class="form-select" name="local_model_key" data-tts-local-model-selector>
              <option value="">Choose local model</option>
              <% localTtsModels.forEach((model) => { %>
                <option value="<%= model.key %>" <%= formDefaults.localModelKey === model.key ? 'selected' : '' %>><%= model.displayName %></option>
              <% }) %>
            </select>
            <div class="form-text">Model diambil dari folder lokal <code>model_tts</code> dan akan dipakai untuk test suara Piper.</div>
          </div>
          <div class="col-md-3">
            <label class="form-label">Language</label>
            <input class="form-control" name="language" value="<%= formDefaults.language %>">
          </div>
          <div class="col-md-3">
            <label class="form-label">Voice identifier</label>
            <input class="form-control" name="voice_identifier" value="<%= formDefaults.voiceIdentifier %>" placeholder="alloy-id-female-01">
          </div>
          <div class="col-md-4">
            <label class="form-label">Speaking style</label>
            <select class="form-select" name="speaking_style">
              <option value="" <%= !formDefaults.speakingStyle ? 'selected' : '' %>>Auto</option>
              <% ['NARRATION','CONVERSATIONAL','CALM','ENERGETIC','DRAMATIC','AUTHORITATIVE'].forEach((value) => { %>
                <option value="<%= value %>" <%= formDefaults.speakingStyle === value ? 'selected' : '' %>><%= value %></option>
              <% }) %>
            </select>
            <div class="form-text">Pilih karakter delivery utama. Fine-tuning tetap bisa diarahkan lewat tone notes dan delivery goal.</div>
          </div>
          <div class="col-md-4">
            <label class="form-label">Emotion baseline</label>
            <select class="form-select" name="emotion">
              <% ['neutral','curious','serious','dramatic','hopeful','sad','surprised','calm'].forEach((emotion) => { %>
                <option value="<%= emotion %>" <%= formDefaults.emotion === emotion ? 'selected' : '' %>><%= emotion %></option>
              <% }) %>
            </select>
          </div>
          <div class="col-md-4">
            <label class="form-label">Target duration ms</label>
            <input type="hidden" name="target_duration_ms" value="<%= formDefaults.targetDurationMs %>" data-tts-target-duration-hidden>
            <input
              class="form-control"
              type="text"
              value="<%= formDefaults.targetDurationMs ? `${formDefaults.targetDurationMs} ms` : '' %>"
              placeholder="Terhitung otomatis dari script + speaking speed"
              disabled
              data-tts-target-duration-display
            >
            <div class="form-text" data-tts-target-duration-help>Estimasi durasi akan dihitung otomatis dari panjang script dan speaking speed.</div>
          </div>
          <div class="col-md-4">
            <label class="form-label">Speaking speed</label>
            <input class="form-control" name="speaking_speed" type="number" min="0.5" max="3" step="0.1" value="<%= formDefaults.speakingSpeed %>" data-tts-speaking-speed>
            <div class="form-text" data-tts-speed-help>1.0 = natural. Naikkan jika ingin delivery lebih cepat, turunkan jika ingin lebih tenang.</div>
          </div>
          <div class="col-md-4">
            <label class="form-label">Pitch</label>
            <input class="form-control" name="pitch" type="number" min="-20" max="20" step="0.5" value="<%= formDefaults.pitch %>">
          </div>
          <div class="col-md-4">
            <label class="form-label">Pause intensity</label>
            <input class="form-control" name="pause_intensity" type="number" min="0" max="3" step="0.1" value="<%= formDefaults.pauseIntensity %>">
          </div>
        </div>

        <div class="candidate-caption-box mt-3">
          <div class="tts-model-preview-header">
            <div>
              <strong>Test suara model lokal</strong>
              <p class="mb-0">Pilih model lalu generate sample audio seperti preview di halaman sample Piper.</p>
            </div>
            <div class="tts-model-badges" data-tts-model-badges>
              <span>Belum ada model dipilih</span>
            </div>
          </div>
          <div class="row g-3 mt-1">
            <div class="col-12">
              <label class="form-label">Sample preview text</label>
              <textarea class="form-control" name="sample_preview_text" rows="3" maxlength="500" data-tts-preview-text><%= formDefaults.samplePreviewText %></textarea>
            </div>
            <div class="col-12">
              <div class="tts-preview-actions">
                <button class="btn btn-outline-primary" type="button" data-tts-preview-button>Generate test voice</button>
                <span class="text-muted small" data-tts-preview-status>Preview audio belum dibuat.</span>
              </div>
              <audio class="tts-preview-audio" controls preload="none" data-tts-preview-audio></audio>
            </div>
          </div>
        </div>
      </div>
    </section>

    <section class="wizard-step">
      <div class="step-number">2</div>
      <div class="step-body">
        <h2>Script dan arahan editor</h2>
        <p class="user-step-lead">Isi script lengkap, lalu tambahkan arahan delivery seperlunya agar hasil audio tetap natural dan konsisten.</p>
        <div class="row g-3">
          <div class="col-12">
            <label class="form-label">Narration script</label>
            <textarea class="form-control" name="script" rows="12" maxlength="100000" placeholder="Masukkan script narasi lengkap di sini..." required data-tts-script></textarea>
            <div class="form-text">Prompt TTS akan menjaga wording tetap sama. Model hanya boleh membagi script menjadi segmen narasi alami.</div>
          </div>
          <div class="col-md-6">
            <label class="form-label">Delivery goal</label>
            <textarea class="form-control" name="delivery_goal" rows="4" maxlength="4000" placeholder="Contoh: terdengar seperti narrator dokumenter Indonesia yang tenang, tajam, dan kredibel."><%= formDefaults.deliveryGoal %></textarea>
          </div>
          <div class="col-md-6">
            <label class="form-label">Tone notes</label>
            <textarea class="form-control" name="tone_notes" rows="4" maxlength="4000" placeholder="Contoh: jangan terlalu teatrikal, tetap jelas, beri penekanan di fakta penting."><%= formDefaults.toneNotes %></textarea>
          </div>
          <div class="col-md-4">
            <label class="form-label">Segmentation mode</label>
            <select class="form-select" name="segmentation_mode">
              <option value="LOCAL_HEURISTIC" <%= formDefaults.segmentationMode === 'LOCAL_HEURISTIC' ? 'selected' : '' %>>LOCAL_HEURISTIC - testing tanpa OpenAI</option>
              <option value="OPENAI" <%= formDefaults.segmentationMode === 'OPENAI' ? 'selected' : '' %>>OPENAI - analisis segmentasi lebih kaya</option>
            </select>
            <div class="form-text">Untuk generate text testing, pilih <code>LOCAL_HEURISTIC</code> agar segmentasi dibuat lokal dan tidak hit OpenAI.</div>
          </div>
          <div class="col-md-4">
            <label class="form-label">Segment length preference</label>
            <select class="form-select" name="segment_length_preference">
              <% ['SHORT','BALANCED','LONG'].forEach((option) => { %>
                <option value="<%= option %>" <%= formDefaults.segmentLengthPreference === option ? 'selected' : '' %>><%= option %></option>
              <% }) %>
            </select>
          </div>
          <div class="col-md-4">
            <label class="form-label">Breathing style</label>
            <select class="form-select" name="breathing_style">
              <% ['MINIMAL','NATURAL','DRAMATIC'].forEach((option) => { %>
                <option value="<%= option %>" <%= formDefaults.breathingStyle === option ? 'selected' : '' %>><%= option %></option>
              <% }) %>
            </select>
          </div>
          <div class="col-md-4">
            <label class="form-label">Pronunciation dictionary</label>
            <textarea class="form-control" name="pronunciation_dictionary" rows="3" placeholder="contoh&#10;Prabowo=Pra-bo-wo&#10;APBN=A Pe Be En"></textarea>
            <div class="form-text">Format satu baris per item: <code>term=pelafalan</code>.</div>
          </div>
        </div>
      </div>
    </section>

    <section class="wizard-step">
      <div class="step-number">3</div>
      <div class="step-body">
        <h2>Output config</h2>
        <p class="user-step-lead">Pilih format dan parameter audio akhir yang ingin kamu simpan di hasil job.</p>
        <div class="row g-3">
          <div class="col-md-4">
            <label class="form-label">Preferred format</label>
            <select class="form-select" name="preferred_format">
              <% ['WAV','MP3','OGG'].forEach((format) => { %>
                <option value="<%= format %>" <%= formDefaults.preferredFormat === format ? 'selected' : '' %>><%= format %></option>
              <% }) %>
            </select>
            <div class="form-text">Format akhir audio narration akan dirender sesuai pilihan ini.</div>
          </div>
          <div class="col-md-4">
            <label class="form-label">Sample rate</label>
            <input class="form-control" name="sample_rate" type="number" min="8000" max="96000" value="<%= formDefaults.sampleRate %>">
          </div>
          <div class="col-md-4">
            <label class="form-label">Channels</label>
            <input class="form-control" name="channels" type="number" min="1" max="2" value="<%= formDefaults.channels %>">
          </div>
        </div>
      </div>
    </section>

    <section class="wizard-step">
      <div class="step-number">4</div>
      <div class="step-body">
        <h2>Review dan submit</h2>
        <p class="user-step-lead">Cek ringkasan terakhir sebelum render audio dimulai.</p>
        <div class="job-summary-grid">
          <article class="job-summary-card">
            <span>Audience hint</span>
            <strong><%= formDefaults.audienceHint || '-' %></strong>
            <p class="mb-0 mt-1 text-secondary small">Diambil dari setting user bila tersedia.</p>
          </article>
          <article class="job-summary-card">
            <span>Niche hint</span>
            <strong><%= formDefaults.nicheHint || '-' %></strong>
            <p class="mb-0 mt-1 text-secondary small">Bisa dipakai saat menulis script narasi.</p>
          </article>
          <article class="job-summary-card">
            <span>Workflow output</span>
            <strong>Segments JSON + WAV audio</strong>
            <p class="mb-0 mt-1 text-secondary small">Detail job akan menampilkan segment plan dan player audio hasil render.</p>
          </article>
        </div>
        <button class="btn btn-primary mt-3" type="submit">Create TTS job</button>
      </div>
    </section>
  </form>
</main></div>
<%- include('../partials/footer') %>
